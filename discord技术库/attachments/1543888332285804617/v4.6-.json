      "replaceString": "<script>\n// ============================================================\n//  1. 核心数据（按协议字段统一）\n// ============================================================\nconst state = {\n  user: { day: 1, weather: '晴', stamina: 100, mood: '平静', lust: 0 },\n  resources: { '淡水': 5, '食物': 3, '燃料': 4, '草药': 1, '御寒物件': 0 },\n  characters: [\n    { id: 'c1', name: '林静月', love: 8, lust: 100, mind: '', married: true, plot: '未解锁', sex: '无' },\n    { id: 'c2', name: '苏念', love: 10, lust: 100, mind: '', married: true, plot: '未解锁', sex: '无' },\n    { id: 'c3', name: '赵梦露', love: 12, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c4', name: '周怡', love: 10, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c5', name: '秦霜', love: 11, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c6', name: '杨悦', love: 10, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c7', name: '唐棠', love: -10, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c8', name: '田甜', love: 12, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c9', name: '顾念', love: 10, lust: 100, mind: '', married: true, plot: '未解锁', sex: '无' },\n    { id: 'c10', name: '沈琳', love: 25, lust: 100, mind: '', married: true, plot: '未解锁', sex: '无' },\n    { id: 'c11', name: '温子萱', love: 45, lust: 0, mind: '', married: false, plot: '未解锁', sex: '无' },\n    { id: 'c12', name: '陆清澜', love: 6, lust: 100, mind: '', married: true, plot: '未解锁', sex: '无' }\n  ],\n  logs: [],\n  branches: [\n    { id: 'b1', name: '无影灯', char: '林静月', condition: '重伤员出现' },\n    { id: 'b2', name: '治愈治愈者', char: '苏念', condition: '团队大冲突后' },\n    { id: 'b3', name: '没电的云台', char: '赵梦露', condition: '撞见自言自语' },\n    { id: 'b4', name: '你走来的声音', char: '周怡', condition: '夜中报位置' },\n    { id: 'b5', name: '疤痕', char: '秦霜', condition: '无意看到左臂疤' },\n    { id: 'b6', name: '花环', char: '杨悦', condition: '发现编花环' },\n    { id: 'b7', name: '通过周怡的背书', char: '唐棠', condition: '对周怡长期温柔' },\n    { id: 'b8', name: '不是吉祥物', char: '田甜', condition: '展露逻辑才华' },\n    { id: 'b9', name: '铅笔', char: '顾念', condition: '认真听原理' },\n    { id: 'b10', name: '靠山也要靠一靠', char: '沈琳', condition: '察觉她强撑' },\n    { id: 'b11', name: '旧笔记本', char: '温子萱', condition: '无意发现笔记本' },\n    { id: 'b12', name: '不图你什么', char: '陆清澜', condition: '不求回报的好' }\n  ],\n  areas: [\n    { id: 1, name: '珊瑚浅滩', unlocked: true },\n    { id: 2, name: '浅型森林', unlocked: true },\n    { id: 3, name: '迷踪溪谷', unlocked: true },\n    { id: 4, name: '深型森林', unlocked: true },\n    { id: 5, name: '幽荧洞穴', unlocked: true },\n    { id: 6, name: '黑风崖', unlocked: true },\n    { id: 7, name: '泥沼', unlocked: true },\n    { id: 8, name: '平坦草原', unlocked: true },\n    { id: 9, name: '死火山口', unlocked: true }\n  ],\n  jobs: [\n    { id: 'water', name: '淡水采集', members: [] },\n    { id: 'food', name: '食物采集', members: [] },\n    { id: 'fuel', name: '燃料采集', members: [] },\n    { id: 'herb', name: '草药采集', members: [] },\n    { id: 'warm', name: '御寒物件采集', members: [] }\n  ],\n  sexUnlockedSet: new Set()\n};\nstate.jobs[0].members.push('你');\n\n// ============================================================\n//  2. 渲染引擎（移除状态与资源）\n// ============================================================\nfunction renderAll() {\n  renderCharacters();\n  renderLogs();\n  renderBranches();\n  renderWork();\n  renderLocations();\n}\n\nfunction renderCharacters() {\n  const container = document.getElementById('charListContainer');\n  container.innerHTML = '';\n  state.characters.forEach(c => {\n    const row = document.createElement('div'); row.className = 'char-row';\n    const specialLabel = c.married ? '忠诚度' : '堕落度';\n    const sexUnlocked = state.sexUnlockedSet.has(c.id);\n    row.innerHTML = '<span class=\"char-name\">' + c.name + '</span>' +\n      '<span class=\"char-meta\">❤️' + c.love + ' | ' + specialLabel + ':' + c.lust + '</span>' +\n      (c.mind ? '<span style=\"font-size:11px;color:#6b4d3a;width:100%;font-style:italic;\">\"' + c.mind + '\"</span>' : '') +\n      '<div class=\"char-actions\">' +\n        '<button class=\"btn-sm\" onclick=\"charAction(\\'' + c.id + '\\',\\'交谈\\')\">💬交谈</button>' +\n        '<button class=\"btn-sm\" onclick=\"charAction(\\'' + c.id + '\\',\\'送礼\\')\">🎁送礼</button>' +\n        '<button class=\"btn-sm\" onclick=\"charAction(\\'' + c.id + '\\',\\'一起行动\\')\">🤝行动</button>' +\n        '<button class=\"btn-sm ' + (sexUnlocked?'sex-unlocked':'locked') + '\" onclick=\"charAction(\\'' + c.id + '\\',\\'找地方性行为\\')\" ' + (sexUnlocked?'':'disabled') + '>🔞性' + (sexUnlocked?'':'🔒') + '</button>' +\n      '</div>';\n    container.appendChild(row);\n  });\n}\n\nfunction renderLogs() {\n  const list = document.getElementById('logList');\n  list.innerHTML = state.logs.map(e => '<li>' + e + '</li>').join('');\n}\n\nfunction renderBranches() {\n  const container = document.getElementById('branchContainer');\n  container.innerHTML = '';\n  state.branches.forEach(b => {\n    const char = state.characters.find(c => c.name === b.char);\n    const plot = char ? char.plot : '未解锁';\n    let condMet = (plot !== '未解锁');\n    let progress = plot;\n    const div = document.createElement('div'); div.className = 'branch-item';\n    const leftBadge = condMet ? '<span class=\"badge badge-met\">已满足条件</span>' : '<span class=\"badge badge-unmet\">未满足条件</span>';\n    let rightBadge = '';\n    if (progress === '未解锁') rightBadge = '<span class=\"badge badge-locked\">未解锁</span>';\n    else if (progress === '已解锁') rightBadge = '<span class=\"badge badge-ongoing\">已解锁（待触发）</span>';\n    else if (progress === '进行中') rightBadge = '<span class=\"badge badge-ongoing\">进行中</span>';\n    else if (progress === '已完成') rightBadge = '<span class=\"badge badge-done\">已完成 ✅</span>';\n    div.innerHTML = \n      '<div class=\"branch-left\">' +\n        '<div class=\"branch-name\"><strong>' + b.name + '</strong></div>' +\n        '<div class=\"branch-char\">' + b.char + '</div>' +\n      '</div>' +\n      '<div class=\"branch-right\">' +\n        '<div class=\"branch-condition\"><small>' + b.condition + '</small></div>' +\n        '<div class=\"branch-badges\">' + leftBadge + ' ' + rightBadge + '</div>' +\n      '</div>';\n    container.appendChild(div);\n  });\n}\n\nfunction renderWork() {\n  const container = document.getElementById('workContainer');\n  container.innerHTML = '';\n  state.jobs.forEach(job => {\n    const div = document.createElement('div');\n    div.className = 'work-item';\n    const membersStr = job.members.length ? job.members.join(', ') : '无人';\n    div.innerHTML = '<span class=\"w-name\">' + job.name + '</span>' +\n      '<span class=\"w-members\">👥 ' + membersStr + '</span>' +\n      '<button class=\"btn-sm\" onclick=\"joinJob(\\'' + job.id + '\\')\">加入</button>' +\n      '<button class=\"btn-sm\" onclick=\"leaveJob(\\'' + job.id + '\\')\">退出</button>';\n    container.appendChild(div);\n  });\n  const myJobs = state.jobs.filter(j => j.members.includes('你')).map(j => j.name);\n  document.getElementById('myWorkDisplay').textContent = myJobs.length ? myJobs[0] : '未分配';\n}\n\nfunction renderLocations() {\n  const container = document.getElementById('locationBtnContainer');\n  container.innerHTML = '';\n  state.areas.forEach(area => {\n    const btn = document.createElement('button');\n    btn.className = 'location-btn';\n    btn.textContent = '📍 ' + area.name;\n    btn.onclick = () => goToLocation(area.name);\n    container.appendChild(btn);\n  });\n}\n\n// ============================================================\n//  3. 交互函数\n// ============================================================\nfunction toggleModal() {\n  const modal = document.getElementById('islandModal');\n  modal.classList.toggle('show');\n  if (modal.classList.contains('show')) refreshFromChat();\n}\n\nfunction switchPage(pageId, cardEl) {\n  document.querySelectorAll('.island-card').forEach(c => c.classList.remove('active'));\n  if (cardEl) cardEl.classList.add('active');\n  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n  document.getElementById(pageId).classList.add('active');\n}\n\nfunction insertChatText(text) {\n  const ta = document.querySelector('textarea') || document.querySelector('.chat-input-scope textarea') || document.querySelector('.chatMsgTextarea textarea');\n  if (ta) {\n    const val = ta.value;\n    const newVal = val + (val && !val.endsWith(' ') ? ' ' : '') + text;\n    const set = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;\n    if (set) { set.call(ta, newVal); ta.dispatchEvent(new Event('input', { bubbles: true })); }\n    else { ta.value = newVal; ta.dispatchEvent(new Event('input')); }\n  } else { alert('未找到输入框，请手动输入：' + text); }\n}\n\nfunction charAction(charId, action) {\n  const char = state.characters.find(c => c.id === charId);\n  if (!char) return;\n  if (action === '找地方性行为') {\n    if (!state.sexUnlockedSet.has(charId)) { alert('尚未与' + char.name + '解锁性行为'); return; }\n    insertChatText('与' + char.name + '寻找私密处所进行亲密接触');\n    addLog('你与' + char.name + '进行了私密互动');\n    return;\n  }\n  const map = { '交谈':'深入交谈', '送礼':'赠送物资', '一起行动':'邀请同行' };\n  insertChatText('与' + char.name + (map[action]||action));\n  addLog('你对' + char.name + '执行了【' + action + '】');\n}\n\nfunction addLog(text) {\n  const input = document.getElementById('newLogInput');\n  const msg = text || input.value.trim();\n  if (!msg) return;\n  state.logs.unshift(msg);\n  if (state.logs.length > 80) state.logs.pop();\n  renderLogs();\n  if (!text) input.value = '';\n}\n\nfunction joinJob(jobId) {\n  const job = state.jobs.find(j => j.id === jobId);\n  if (!job) return;\n  // 先移除玩家在其他所有工作\n  state.jobs.forEach(j => { const idx = j.members.indexOf('你'); if (idx > -1) j.members.splice(idx, 1); });\n  job.members.push('你');\n  const resMap = { 'water':'淡水', 'food':'食物', 'fuel':'燃料', 'herb':'草药', 'warm':'御寒物件' };\n  const res = resMap[jobId];\n  if (res && state.resources[res] !== undefined) { state.resources[res] += 1; addLog('加入' + job.name + '，' + res + '+1'); }\n  renderWork();\n}\n\nfunction leaveJob(jobId) {\n  const job = state.jobs.find(j => j.id === jobId);\n  if (!job) return;\n  const idx = job.members.indexOf('你');\n  if (idx > -1) { job.members.splice(idx, 1); addLog('退出' + job.name); renderWork(); }\n}\n\nfunction forceReassign() {\n  insertChatText('【强制指令】请AI重新分配所有12位女性角色到五个资源采集组（淡水、食物、燃料、草药、御寒物件），确保每组至少2人，并输出新的分配名单。');\n  addLog('发出“重新分配工作”指令');\n}\n\nfunction goToLocation(loc) {\n  insertChatText('前往' + loc);\n  addLog('前往' + loc);\n}\n\n// ============================================================\n//  4. 解析协议状态栏（核心监听）\n// ============================================================\nfunction refreshFromChat() {\n  const bodyHtml = document.body.innerHTML || '';\n  const allMatches = bodyHtml.match(/<status>([\\s\\S]*?)<\\/status>/g);\n  if (allMatches && allMatches.length) {\n    const last = allMatches[allMatches.length - 1];\n    const inner = last.replace(/^<status>/, '').replace(/<\\/status>$/, '');\n    parseStatus(inner);\n  }\n  renderAll();\n}\n\nfunction parseStatus(html) {\n  const div = document.createElement('div');\n  div.innerHTML = html;\n  const charEls = div.querySelectorAll('[data-char]');\n  charEls.forEach(el => {\n    const name = (el.getAttribute('n') || '').trim();\n    const love = parseInt(el.getAttribute('love')) || 0;\n    const lust = parseInt(el.getAttribute('lust')) || 0;\n    const mind = el.getAttribute('mind') || '';\n    const sex = el.getAttribute('sex') || '无';\n    const plot = el.getAttribute('plot') || '未解锁';\n    const char = state.characters.find(c => c.name === name);\n    if (char) {\n      char.love = love;\n      char.lust = lust;\n      char.mind = mind;\n      char.plot = plot;\n      if (sex && sex !== '无') {\n        state.sexUnlockedSet.add(char.id);\n        addLog('🔓 与' + char.name + '解锁性行为（' + sex + '）');\n      }\n    }\n  });\n}\n\n// ============================================================\n//  5. 拖动逻辑（鼠标 + 触摸）\n// ============================================================\nlet isDragging = false, dragStartX, dragStartY, startLeft, startTop;\nlet lastClientX = 0, lastClientY = 0;\nconst btn = document.getElementById('floatBtn');\n\nfunction startDrag(clientX, clientY) {\n  isDragging = true;\n  const rect = btn.getBoundingClientRect();\n  dragStartX = clientX;\n  dragStartY = clientY;\n  startLeft = rect.left;\n  startTop = rect.top;\n  btn.style.cursor = 'grabbing';\n  btn.style.transition = 'none';\n  lastClientX = clientX;\n  lastClientY = clientY;\n}\n\nfunction moveDrag(clientX, clientY) {\n  if (!isDragging) return;\n  lastClientX = clientX;\n  lastClientY = clientY;\n  const dx = clientX - dragStartX;\n  const dy = clientY - dragStartY;\n  let newLeft = startLeft + dx;\n  let newTop = startTop + dy;\n  newLeft = Math.max(0, Math.min(window.innerWidth - 70, newLeft));\n  newTop = Math.max(0, Math.min(window.innerHeight - 70, newTop));\n  btn.style.left = newLeft + 'px';\n  btn.style.top = newTop + 'px';\n  btn.style.right = 'auto';\n  btn.style.bottom = 'auto';\n}\n\nfunction endDrag(clientX, clientY) {\n  if (isDragging) {\n    isDragging = false;\n    btn.style.cursor = 'grab';\n    const dx = clientX - dragStartX;\n    const dy = clientY - dragStartY;\n    if (Math.sqrt(dx*dx + dy*dy) < 5) {\n      toggleModal();\n    }\n  }\n}\n\nbtn.addEventListener('mousedown', (e) => {\n  startDrag(e.clientX, e.clientY);\n  e.preventDefault();\n});\ndocument.addEventListener('mousemove', (e) => { moveDrag(e.clientX, e.clientY); });\ndocument.addEventListener('mouseup', (e) => { endDrag(e.clientX, e.clientY); });\n\nbtn.addEventListener('touchstart', (e) => {\n  const touch = e.touches[0];\n  startDrag(touch.clientX, touch.clientY);\n  e.preventDefault();\n}, { passive: false });\n\ndocument.addEventListener('touchmove', (e) => {\n  const target = e.target;\n  const isOnFloatBtn = target.closest('#floatBtn');\n  if (isOnFloatBtn) {\n    const touch = e.touches[0];\n    moveDrag(touch.clientX, touch.clientY);\n    e.preventDefault();\n  }\n}, { passive: false });\n\ndocument.addEventListener('touchend', (e) => {\n  endDrag(lastClientX, lastClientY);\n}, { passive: false });\n\nbtn.addEventListener('dragstart', (e) => e.preventDefault());\n\n// ============================================================\n//  6. 初始化与观察者\n// ============================================================\ndocument.addEventListener('DOMContentLoaded', function() {\n  state.logs = ['🏝️ 登岛，建立营地', '🌳 发现浅型森林', '🩹 林静月处理擦伤'];\n  renderAll();\n\n  const observer = new MutationObserver(() => {\n    clearTimeout(window._refreshTimer);\n    window._refreshTimer = setTimeout(() => {\n      if (document.getElementById('islandModal').classList.contains('show')) {\n        refreshFromChat();\n      }\n    }, 2000);\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n\n  document.getElementById('islandModal').addEventListener('click', function(e) {\n    if (e.target === this) toggleModal();\n  });\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      const modal = document.getElementById('islandModal');\n      if (modal.classList.contains('show')) toggleModal();\n    }\n  });\n});\n\nwindow.state = state;\nwindow.renderAll = renderAll;\nwindow.toggleModal = toggleModal;\nwindow.switchPage = switchPage;\nwindow.charAction = charAction;\nwindow.insertChatText = insertChatText;\nwindow.addLog = addLog;\nwindow.joinJob = joinJob;\nwindow.leaveJob = leaveJob;\nwindow.forceReassign = forceReassign;\nwindow.goToLocation = goToLocation;\nwindow.refreshFromChat = refreshFromChat;\n\n// ===== 确保悬浮球和模态框位于 body 最外层 =====\n(function() {\n  const floatBtn = document.getElementById('floatBtn');\n  const modal = document.getElementById('islandModal');\n  if (floatBtn && floatBtn.parentNode !== document.body) {\n    document.body.appendChild(floatBtn);\n  }\n  if (modal && modal.parentNode !== document.body) {\n    document.body.appendChild(modal);\n  }\n})();\n</script>",

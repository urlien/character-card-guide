      "replaceString": "<!-- ===== 可拖动圆形悬浮球 ===== -->\n<div id=\"floatBtn\" title=\"拖拽移动\">\n  🌴\n  <span class=\"label\">荒岛</span>\n</div>\n\n<!-- ===== 模态面板 ===== -->\n<div class=\"island-modal\" id=\"islandModal\">\n  <div class=\"island-box\">\n    <div class=\"island-header\">\n      <h2>🏝️ 荒岛生存</h2>\n      <span class=\"island-close\" onclick=\"toggleModal()\">&times;</span>\n    </div>\n    <div class=\"island-scroll\" id=\"cardScroll\">\n      <div class=\"island-card active\" data-page=\"page-char\" onclick=\"switchPage('page-char',this)\"><div class=\"icon\">👩</div><div class=\"label\">角色</div></div>\n      <div class=\"island-card\" data-page=\"page-log\" onclick=\"switchPage('page-log',this)\"><div class=\"icon\">📜</div><div class=\"label\">日志</div></div>\n      <div class=\"island-card\" data-page=\"page-branch\" onclick=\"switchPage('page-branch',this)\"><div class=\"icon\">✨</div><div class=\"label\">支线</div></div>\n      <div class=\"island-card\" data-page=\"page-work\" onclick=\"switchPage('page-work',this)\"><div class=\"icon\">🔧</div><div class=\"label\">工作</div></div>\n      <div class=\"island-card\" data-page=\"page-map\" onclick=\"switchPage('page-map',this)\"><div class=\"icon\">🗺️</div><div class=\"label\">地图</div></div>\n    </div>\n    <div class=\"island-content\" id=\"contentArea\">\n      <!-- 1. 角色 -->\n      <div class=\"page active\" id=\"page-char\">\n        <div class=\"section-title\">👩 女性角色</div>\n        <div id=\"charListContainer\" class=\"char-list\"></div>\n        <button class=\"btn\" style=\"margin-top:10px;\" onclick=\"refreshFromChat()\">🔄 刷新</button>\n      </div>\n      <!-- 2. 日志 -->\n      <div class=\"page\" id=\"page-log\">\n        <div class=\"section-title\">📜 事件日志（最多80条）</div>\n        <ul class=\"log-list\" id=\"logList\"></ul>\n        <div style=\"display:flex; gap:8px; margin-top:8px;\">\n          <input type=\"text\" id=\"newLogInput\" placeholder=\"手动添加\" style=\"flex:1; padding:6px 12px; border:1px solid #c4a88a; border-radius:16px; background:#fcf7f2;\">\n          <button class=\"btn\" onclick=\"addLog()\">添加</button>\n        </div>\n      </div>\n      <!-- 3. 支线 -->\n      <div class=\"page\" id=\"page-branch\">\n        <div class=\"section-title\">✨ 支线剧情</div>\n        <div id=\"branchContainer\"></div>\n        <button class=\"btn\" style=\"margin-top:10px;\" onclick=\"refreshFromChat()\">🔄 检测进度</button>\n      </div>\n      <!-- 4. 工作 -->\n      <div class=\"page\" id=\"page-work\">\n        <div class=\"section-title\">🔧 资源采集小组</div>\n        <button class=\"btn btn-primary\" style=\"margin-bottom:10px;\" onclick=\"forceReassign()\">📢 重新分配（输出指令）</button>\n        <div id=\"workContainer\" class=\"work-group\"></div>\n        <div style=\"margin-top:10px; font-size:13px; background:#ede3d9; padding:8px 12px; border-radius:12px;\">\n          <strong>你在：</strong><span id=\"myWorkDisplay\">未分配</span>\n        </div>\n      </div>\n      <!-- 5. 地图 -->\n      <div class=\"page\" id=\"page-map\">\n        <div class=\"section-title\">🗺️ 岛屿地图</div>\n        <div class=\"map-container\">\n          <div id=\"locationBtnContainer\" style=\"margin:10px 0;\"></div>\n          <p class=\"unlock-hint\">📍 所有区域均已解锁，点击即可前往。</p>\n        </div>\n      </div>\n    </div><!-- content -->\n  </div><!-- box -->\n</div><!-- modal -->",

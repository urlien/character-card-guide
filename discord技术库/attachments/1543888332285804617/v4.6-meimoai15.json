'button','isld-cbtn','🤝');b3.setAttribute('data-n',nm);b3.setAttribute('data-act','go');b3.onclick=function(){act(this.getAttribute('data-n'),this.getAttribute('data-act'));};bs.appendChild(b3);if(SEX[nm]){var b4=mk('button','isld-cbtn','🔞');b4.setAttribute('data-n',nm);b4.setAttribute('data-act','sex');b4.onclick=function(){act(this.getAttribute('data-n'),this.getAttribute('data-act'));};bs.appendChild(b4);}else{bs.appendChild(mk('button','isld-cbtn lk','🔒'));}r.appendChild(bs);L.appendChild(r);}} function rdLogs(){var G=document.getElementById('isld-p-log');if(!G)return;clr(G);var k;for(k=0;k&lt;LOGS.length;k++)G.appendChild(mk('div','isld-logitem',LOGS[k]));} function rdBranch(){var B=document.getElementById('isld-p-branch');if(!B)return;clr(B);var k,c;for(k=0;k&lt;BRANCH.length;k++){var pl='未解锁';for(c=0;c&lt;CHAR.length;c++)if(CHAR[c].n===BRANCH[k][1]){pl=CHAR[c].pl;break;}var bdg=(pl==='进行中'?'进行中':(pl==='已完成'?'已完成':(pl!=='未解锁'?'已满足':'未解锁')));var row=mk('div','isld-bi');row.appendChild(mk('span','isld-bname',BRANCH[k][0]));row.appendChild(mk('span','isld-bchar',BRANCH[k][1]));row.appendChild(mk('span','isld-bbadge',bdg));B.appendChild(row);}} function rdWork(){var W=document.getElementById('isld-p-work');if(!W)return;clr(W);var k;for(k=0;k&lt;JOBS.length;k++){var row=mk('div','isld-wi');row.appendChild(mk('span','isld-wname',JOBS[k]));var b=mk('button','isld-wbtn','加入');b.setAttribute('data-job',k);b.onclick=function(){var j=parseInt(this.getAttribute('data-job'),10);insChat('申请加入'+JOBS[j]+'采集小组');addLog('申请加入'+JOBS[j]+'采集小组');};row.appendChild(b);W.appendChild(row);}} function rdMap(){var M=document.getElementById('isld-p-map');if(!M)return;clr(M);var k;for(k=0;k&lt;AREAS.length;k++){var row=mk('div','isld-mi');row.appendChild(mk('span','isld-mname','📍 '+AREAS[k]));var b=mk('button','isld-mbtn','前往');b.setAttribute('data-area',k);b.onclick=function(){var j=parseInt(this.getAttribute('data-area'),10);insChat('前往'+AREAS[j]);addLog('前往'+AREAS[j]);};row.appendChild(b);M.appendChild(row);}} function insChat(t){var ta=document.querySelector('textarea')||document.querySelector('.chat-input-scope textarea')||document.querySelector('.chatMsgTextarea textarea');if(ta){var old=ta.value||'';var set=Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype,'value').set;if(set){set.call(ta,old+(old&amp;&amp;!/\\s$/.test(old)?' ':'')+t);ta.dispatchEvent(new Event('input',{bubbles:true}));}else{ta.value=old+t;}return true;}return false;} function addLog(t){LOGS.unshift(t);if(LOGS.length&gt;80)LOGS.pop();rdLogs();} window.__isldOpen=function(){var m=document.getElementById('isld-modal');if(m){m.classList.toggle('isld-on');if(m.className.indexOf('isld-on')&gt;-1)upd();}}; window.__isldSw=function(i){var tabs=document.querySelectorAll('.isld-tab'),j;for(j=0;j&lt;tabs.length;j++)tabs[j].className='isld-tab'+(j===i?' on':'');var pages=['isld-p-char','isld-p-log','isld-p-branch','isld-p-work','isld-p-map'];for(j=0;j&lt;pages.length;j++){var pg=document.getElementById(pages[j]);if(pg)pg.className='isld-page'+(j===i?' on':'');}}; var exists=null,i,all=document.querySelectorAll('.isld');for(i=0;i&lt;all.length;i++){if(all[i]!==box&amp;&amp;all[i].parentNode===document.body){exists=all[i];break;}} (function(){var fb=document.getElementById('isld-float');if(!fb)return;var d=false,x=0,y=0,sl=0,st=0;function stS(a,b){d=true;var r=fb.getBoundingClientRect();x=a;y=b;sl=r.left;st=r.top;}function stM(a,b){if(!d)return;var nl=Math.max(0,Math.min(window.innerWidth-70,sl+(a-x)));var nt=Math.max(0,Math.min(window.innerHeight-70,st+(b-y)));fb.style.left=nl+'px';fb.style.top=nt+'px';}function stE(){d=false;}fb.addEventListener('mousedown',function(e){stS(e.clientX,e.clientY);e.preventDefault();});document.addEventListener('mousemove',function(e){stM(e.clientX,e.clientY);});document.addEventListener('mouseup',function(){stE();});fb.addEventListener('touchstart',function(e){var t=e.touches[0];stS(t.clientX,t.clientY);e.preventDefault();},{passive:false});document.addEventListener('touchmove',function(e){var t=e.touches[0];if(t&amp;&amp;e.target&amp;&amp;e.target.closest&amp;&amp;e.target.closest('#isld-float')){stM(t.clientX,t.clientY);e.preventDefault();}},{passive:false});document.addEventListener('touchend',function(){stE();},{passive:false});})(); if(exists){upd();if(box.parentNode)box.parentNode.removeChild(box);img.remove();return;} document.body.appendChild(box);upd(); if(!window.__isldObs){window.__isldObs=1;new MutationObserver(function(){clearTimeout(window.__isldT);window.__isldT=setTimeout(function(){upd();},1500);}).observe(document.body,{childList:true,subtree:true}); var mo=document.getElementById('isld-modal');if(mo&amp;&amp;!mo._ib){mo._ib=1;mo.addEventListener('click',function(e){if(e.target===mo)window.__isldOpen();});} if(!window.__isldEsc){window.__isldEsc=1;document.addEventListener('keydown',function(e){if(e.key==='Escape'){var m=document.getElementById('isld-modal');if(m&amp;&amp;m.className.indexOf('isld-on')&gt;-1)window.__isldOpen();}});}} img.remove(); })(this)\"></div>",

      "replaceString": "<div class=\"isld\" onclick=\"event.stopPropagation()\"><style>.isld{font-family:system-ui,sans-serif}#isld-float{position:fixed;right:18px;bottom:80px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#2ec4b6,#3a7bd5);color:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:22px;cursor:pointer;z-index:99999;box-shadow:0 4px 14px rgba(0,0,0,.4);user-select:none}#isld-float .isld-lb{font-size:9px}.isld-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);align-items:center;justify-content:center;z-index:99998}.isld-modal.isld-on{display:flex}.isld-box{background:#fff;width:min(92vw,440px);max-height:82vh;border-radius:14px;padding:14px;font-size:14px;display:flex;flex-direction:column;overflow:hidden}.isld-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.isld-close{cursor:pointer;font-size:24px;color:#888}.isld-env{font-size:12px;color:#666;margin-bottom:8px;padding:6px 10px;background:#f0f7f6;border-radius:8px}.isld-tabs{display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap}.isld-tab{flex:1;min-width:52px;text-align:center;padding:6px 4px;border-radius:8px;background:#eef2f1;cursor:pointer;font-size:12px}.isld-tab.on{background:#2ec4b6;color:#fff}.isld-scroll{overflow-y:auto;flex:1}.isld-page{display:none}.isld-page.on{display:block}.isld-crow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:7px 8px;border-bottom:1px dashed #eee}.isld-cname{font-weight:700;min-width:52px}.isld-cmeta{font-size:12px;color:#555;background:#f3f9f8;padding:2px 8px;border-radius:8px}.isld-cmind{font-size:11px;color:#888;width:100%;font-style:italic}.isld-cbtns{display:flex;gap:4px;flex-wrap:wrap}.isld-cbtn{border:0;background:#fff;border:1px solid #2ec4b6;color:#2ec4b6;border-radius:999px;padding:2px 8px;cursor:pointer;font-size:11px}.isld-cbtn.lk{border-color:#ccc;color:#ccc;cursor:default}.isld-logitem{padding:4px 0;font-size:12px;co
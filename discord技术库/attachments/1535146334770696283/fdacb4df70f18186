}
.xiu-input-fake::placeholder { color: #7a5a6a; }
.xiu-input-fake:focus { border-color: rgba(208,96,160,0.7); }
.xiu-input-icons {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    flex-shrink: 0;
}
.xiu-input-icon {
    cursor: pointer;
    transition: transform 0.12s ease;
    display: inline-flex;
    line-height: 1;
}
.xiu-input-icon:active { transform: scale(0.8); }
.xiu-emoji-wrap {
    position: relative;
}
.xiu-emoji-panel {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 6px;
    background: rgba(30,15,26,0.95);
    border: 1px solid rgba(208,96,160,0.4);
    border-radius: 10px;
    padding: 6px;
    display: none;
    gap: 4px;
    z-index: 10;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.5);
}
.xiu-emoji-panel.show { display: flex; }
.xiu-emoji-panel span {
    font-size: 20px;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
    transition: background 0.12s;
    line-height: 1;
}
.xiu-emoji-panel span:hover { background: rgba(208,96,160,0.25); }
.xiu-send-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #d060b0, #ff5c8a);
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(255,92,138,0.4);
    transition: transform 0.12s ease;
    padding: 0;
}
.xiu-send-btn:active { transform: scale(0.85); }
.xiu-send-btn svg { display: block; }

.xiu-float-heart {
    position: absolute;
    bottom: 90px;
    font-size: 30px;
    color: #ff5c8a;
    text-shadow: 0 0 10px rgba(255,92,138,0.9), 0 0 22px rgba(255,92,138,0.5);
    z-index: 5;
    pointer-events: none;
    --drift: 0px;
    animation: xiu-heart-fly 1.3s ease-out forwards;
    will-change: transform, opacity;
}
@keyframes xiu-heart-fly {
    0%   { transform: translate(0, 0) scale(0.4); opacity: 0; }
    18%  { transform: translate(calc(var(--drift) * 0.25), -28px) scale(1.4); opacity: 1; }
    60%  { transform: translate(calc(var(--drift) * 0.7), -120px) scale(1.1); opacity: 0.9; }
    100% { transform: translate(var(--drift), -210px) scale(0.85); opacity: 0; }
}

.xiu-float-rocket {
    position: absolute;
    bottom: 0;
    left: 50%;
    font-size: 42px;
    z-index: 5;
    pointer-events: none;
    text-shadow: 0 0 14px rgba(255,140,60,0.9), 0 0 28px rgba(255,80,40,0.6);
    animation: xiu-rocket-fly 1.7s cubic-bezier(0.5, 0, 0.8, 0.2) forwards;
    will-change: transform, opacity;
}
.xiu-float-rocket::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    width: 6px;
    height: 30px;
    background: linear-gradient(180deg, rgba(255,180,80,0.9), rgba(255,80,40,0));
    border-radius: 3px;
    filter: blur(2px);
}
@keyframes xiu-rocket-fly {
    0%   { transform: translateX(-50%) translateY(40px) scale(0.5) rotate(-8deg); opacity: 0; }
    15%  { transform: translateX(-50%) translateY(0) scale(1.2) rotate(-8deg); opacity: 1; }
    100% { transform: translateX(-50%) translateY(-380px) scale(1) rotate(-8deg); opacity: 0; }
}

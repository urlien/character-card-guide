<script>
(function(){
    var stage = document.getElementById('xiu-stage');
    var likeBtn = document.getElementById('xiu-like-btn');
    var giftBtn = document.getElementById('xiu-gift-btn');
    if (!stage || !likeBtn || !giftBtn) return;
    if (likeBtn.dataset.xiuBound) return;
    likeBtn.dataset.xiuBound = '1';
    giftBtn.dataset.xiuBound = '1';

    likeBtn.addEventListener('click', function(){
        var heart = document.createElement('div');
        heart.className = 'xiu-float-heart';
        heart.textContent = '♥';
        var x = 45 + Math.random() * 30;
        heart.style.left = x + '%';
        var drift = (Math.random() * 60 - 30);
        heart.style.setProperty('--drift', drift + 'px');
        heart.style.fontSize = (24 + Math.random() * 14) + 'px';
        stage.appendChild(heart);
        setTimeout(function(){ if (heart.parentNode) heart.remove(); }, 1300);
    });

    giftBtn.addEventListener('click', function(){
        var rocket = document.createElement('div');
        rocket.className = 'xiu-float-rocket';
        rocket.textContent = '🚀';
        stage.appendChild(rocket);
        setTimeout(function(){ if (rocket.parentNode) rocket.remove(); }, 1700);
    });

    var replyInput = document.getElementById('xiu-reply-input');
    var sendBtn = document.getElementById('xiu-send-btn');
    if (replyInput && sendBtn && !sendBtn.dataset.xiuBound) {
        sendBtn.dataset.xiuBound = '1';
        function xiuFindTarget() {
            var docs = [document];
            try { if (window.parent && window.parent !== window) docs.push(window.parent.document); } catch(e) {}
            try { if (window.top && window.top !== window) docs.push(window.top.document); } catch(e) {}
            for (var i = 0; i < docs.length; i++) {
                var ta = docs[i].querySelector('.chat .chat-bottom .uni-textarea .chat-input-scope textarea');
                if (ta) return ta;
            }
            for (var j = 0; j < docs.length; j++) {
                var ta2 = docs[j].querySelector('textarea');
                if (ta2) return ta2;
            }
            for (var m = 0; m < docs.length; m++) {
                var inputs = docs[m].querySelectorAll('input[type=text]');
                for (var n = 0; n < inputs.length; n++) {
                    if (inputs[n].offsetParent !== null) return inputs[n];
                }
            }
            return null;
        }
        function xiuSendReply() {
            var text = replyInput.value.trim();
            if (!text) return;
            var st = xiuFindTarget();
            if (!st) return;
            try {
                var proto = (st.tagName === 'TEXTAREA') ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
                var setter = Object.getOwnPropertyDescriptor(proto, 'value').set;
                if (setter) setter.call(st, text); else st.value = text;
            } catch(e) {
                st.value = text;
            }
            try {
                st.dispatchEvent(new Event('input', { bubbles: true }));
                st.dispatchEvent(new Event('change', { bubbles: true }));
            } catch(e) {}
            try {
                var jq = window.jQuery || (window.parent && window.parent.jQuery) || (window.top && window.top.jQuery);
                if (jq) jq(st).val(text).trigger('input').trigger('change');
            } catch(e) {}
            try { st.focus(); } catch(e) {}
            replyInput.value = '';
        }
        sendBtn.addEventListener('click', xiuSendReply);
        replyInput.addEventListener('keydown', function(e){
            if (e.key === 'Enter') { e.preventDefault(); xiuSendReply(); }
        });
    }

    var inputGiftBtn = document.getElementById('xiu-input-gift-btn');
    if (inputGiftBtn && !inputGiftBtn.dataset.xiuBound) {
        inputGiftBtn.dataset.xiuBound = '1';
        inputGiftBtn.addEventListener('click', function(){
            if (!stage) return;
            var rocket = document.createElement('div');
            rocket.className = 'xiu-float-rocket';
            rocket.textContent = '🚀';
            stage.appendChild(rocket);
            setTimeout(function(){ if (rocket.parentNode) rocket.remove(); }, 1700);
        });
    }

    var emojiBtn = document.getElementById('xiu-emoji-btn');
    var emojiPanel = document.getElementById('xiu-emoji-panel');
    if (emojiBtn && emojiPanel && replyInput && !emojiBtn.dataset.xiuBound) {
        emojiBtn.dataset.xiuBound = '1';
        emojiBtn.addEventListener('click', function(e){
            e.stopPropagation();
            emojiPanel.classList.toggle('show');
        });
        emojiPanel.addEventListener('click', function(e){
            var t = e.target;
            if (t && t.tagName === 'SPAN' && t.dataset.emoji) {
                replyInput.value += t.dataset.emoji;
                replyInput.focus();
                emojiPanel.classList.remove('show');
            }
        });
        document.addEventListener('click', function(e){
            if (!emojiPanel.contains(e.target) && e.target !== emojiBtn) {
                emojiPanel.classList.remove('show');
            }
        });
    }
})();
</script>

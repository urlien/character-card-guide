<style>
.xiu-live-wrap {
    max-width: 360px;
    margin: 15px auto;
    background: #0d0612;
    border-radius: 16px;
    overflow: hidden;
    font-family: 'KaiTi', 'STKaiti', 'SimSun', 'Microsoft YaHei', serif;
    position: relative;
    box-shadow: 0 8px 30px rgba(200,60,120,0.3), 0 0 0 1px rgba(200,60,120,0.2);
    aspect-ratio: 9 / 20;
    display: flex;
    flex-direction: column;
}

.xiu-streamer-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: linear-gradient(180deg, rgba(15,6,12,0.85) 0%, rgba(15,6,12,0) 100%);
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 4;
    pointer-events: none;
}
.xiu-streamer-bar .xiu-avatar,
.xiu-streamer-bar .xiu-streamer-info,
.xiu-streamer-bar .xiu-follow-btn {
    pointer-events: auto;
}
.xiu-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid #d060a0;
    overflow: hidden;
    flex-shrink: 0;
    background: #1a0a14;
    box-shadow: 0 0 8px rgba(208,96,160,0.5);
}
.xiu-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.xiu-streamer-info {
    flex: 1;
    min-width: 0;
}
.xiu-streamer-name {
    font-size: 14px;
    font-weight: bold;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 5px;
    line-height: 1.2;
}
.xiu-live-tag {
    background: #ff3b5c;
    color: #fff;
    font-size: 9px;
    padding: 1px 5px 1px 4px;
    border-radius: 3px;
    font-weight: normal;
    letter-spacing: 0.5px;
}
.xiu-live-tag::before {
    content: '●';
    font-size: 7px;
    margin-right: 2px;
}
.xiu-viewers {
    font-size: 10px;
    color: #c090b0;
    margin-top: 1px;
}
.xiu-follow-btn {
    background: linear-gradient(90deg, #d060b0, #ff5c8a);
    color: #fff;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 12px;
    border: none;
    font-weight: bold;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(255,92,138,0.4);
}

.xiu-live-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #1a0a14;
    overflow: hidden;
    flex-shrink: 0;
}
.xiu-live-stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.xiu-stage-overlay-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 70px;
    background: linear-gradient(180deg, rgba(13,6,18,0.75) 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
}
.xiu-stage-overlay-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 90px;
    background: linear-gradient(0deg, rgba(13,6,18,0.85) 0%, transparent 100%);
    z-index: 2;
    pointer-events: none;
}

.xiu-loc-pill {
    position: absolute;
    top: 54px;
    right: 10px;
    background: rgba(30,15,26,0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #e8d0e0;
    font-size: 10px;
    padding: 3px 9px;
    border-radius: 11px;
    border: 1px solid rgba(208,96,160,0.4);
    z-index: 3;
    letter-spacing: 0.3px;
}

.xiu-action-rail {
    position: absolute;
    right: 8px;
    bottom: 100px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 5;
}
.xiu-action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    cursor: pointer;
    transition: transform 0.12s ease;
}
.xiu-action-item:active {
    transform: scale(0.8);
}
.xiu-action-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(30,15,26,0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(208,96,160,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
}
.xiu-action-count {
    font-size: 9px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.7);
}
.xiu-action-icon.heart {
    color: #ff5c8a;
    font-size: 34px;
}

.xiu-info-card {
    background: linear-gradient(180deg, #1a0a1f 0%, #0d0612 100%);
    padding: 10px 12px 10px 12px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
}
.xiu-barrage-box {
    height: 150px;
    overflow: hidden;
    position: relative;
    border-radius: 8px;
}
.xiu-barrage-box::before,
.xiu-barrage-box::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 16px;
    z-index: 2;
    pointer-events: none;
}
.xiu-barrage-box::before {
    top: 0;
    background: linear-gradient(180deg, #1a0a1f 0%, transparent 100%);
}
.xiu-barrage-box::after {
    bottom: 0;
    background: linear-gradient(0deg, #0d0612 0%, transparent 100%);
}
.xiu-barrage-track {
    animation: xiu-scroll-up 20s linear infinite;
}
@keyframes xiu-scroll-up {
    0%   { transform: translateY(0); }
    100% { transform: translateY(-50%); }
}
.xiu-info-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 10px;
    margin-bottom: 5px;
    font-size: 12px;
    color: #e8d0e0;
    line-height: 1.3;
    background: rgba(30,15,26,0.55);
    border-radius: 8px;
    border: 1px solid rgba(106,37,64,0.35);
}
.xiu-info-tag {
    background: rgba(208,96,160,0.15);
    color: #d060a0;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 8px;
    border: 1px solid rgba(208,96,160,0.35);
    flex-shrink: 0;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.xiu-input-bar {
    display: flex;

appendChild(b);var sp=ce('div',P('spacer'));ft.appendChild(sp);wrap.appendChild(ft);return wrap;};var buildPriv=function(c){var wrap=ce('div');var sr=ce('div',P('statrow'));sr.appendChild(mkField('sex',c.sex,true,true));sr.appendChild(mkField('shot',c.shot,true,true));wrap.appendChild(sr);if(c.senses&&c.senses!==''){var h=ce('div',P('sec-h'));h.textContent=LB.senses;wrap.appendChild(h);c.senses.split(',').forEach(function(it){it=trim(it);if(!it)return;var ci=it.indexOf(':');if(ci===-1)return;var part=trim(it.slice(0,ci));var num=trim(it.slice(ci+1));var row=ce('div',P('srow'));var lb=ce('div',P('slabel'));lb.textContent=part;row.appendChild(lb);var bar=ce('div',P('sbar'));var fl=ce('div',P('sfill'));fl.style.width=pct(num)+'%';bar.appendChild(fl);row.appendChild(bar);var pc=ce('div',P('spct'));pc.textContent=(num.indexOf('%')===-1?num+'%':num);row.appendChild(pc);wrap.appendChild(row);});}var preg=isYes(c.pregnant);if(preg||(c.period&&c.period!=='')){var pr=ce('div',P('frow'));var pl=ce('span',P('pill')+' '+P('pink')+(preg?' '+P('preg'):''));pl.textContent=LB.period;pr.appendChild(pl);var pv=ce('div',P('val'));pv.textContent=preg?LB.pregLabel:c.period;if(preg){pv.style.color='#ec4a8c';pv.style.fontWeight='800';}pr.appendChild(pv);wrap.appendChild(pr);}var ft=ce('div',P('foot'));var sp=ce('div',P('spacer'));ft.appendChild(sp);var b=ce('div',P('btn')+' '+P('btn-back'));b.textContent='返回';b.onclick=function(ev){ev.stopPropagation();st.page=0;render();};ft.appendChild(b);wrap.appendChild(ft);return wrap;};var panel=ce('div',P('panel'));var render=function(){while(panel.firstChild)panel.removeChild(panel.firstChild);var tabs=ce('div',P('tabs'));chars.forEach(function(c,i){var t=ce('div',P('tab')+(i===st.ci?' on':''));t.textContent=c.name;t.onclick=function(ev){ev.stopPropagation();st.ci=i;render();};tabs.appendChild(t);});panel.appendChild(tabs);var card=ce('div',P('card'));var c=chars[st.ci]||chars[0];card.appendChild(st.page===0?buildPub(c):buildPriv(c));panel.appendCh
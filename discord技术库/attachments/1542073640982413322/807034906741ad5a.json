{"pageDepth":2,"statusbar":"【悬浮球】【美化】","beginning":"【测试开场白】泳池的午后，阳光透过水面洒下细碎的光斑。\n\n<xtl>\nname=苍唯;avatar=;age=22;height=165cm;detail=水原苍唯是个安静、内向的女大学生。暑假期间她来到泳池缓解压力，并终于想学会游泳。//在学校遭受的霸凌在她心里留下了烙印：她至今仍写日记，小心翼翼地学习去信任别人。//她的男友海斗支持着她——但在泳池里，苍唯却逐渐受到坂本龙马的影响。;cup=G;hobby=日记;love=月见;corrupt=116/116;sex=30;shot=70;senses=小穴:93,胸部:83,嘴:67;period=第14天·排卵期;pregnant=否 || name=美波;avatar=;age=20;height=158cm;detail=元气满满的泳池常客，笑起来有小虎牙。//表面大大咧咧，其实心思细腻，最怕被人看穿。;cup=E;hobby=甜点;love=队长;corrupt=60/120;sex=12;shot=25;senses=小穴:55,胸部:70,嘴:40;period=已孕;pregnant=是 || name=神乐;avatar=;age=24;height=170cm;detail=泳池的兼职救生员，冷淡寡言。//对谁都保持距离，唯独对水格外温柔。;cup=F;hobby=游泳;love=——;corrupt=18/150;sex=3;shot=5;senses=小穴:20,胸部:35,嘴:15;period=第3天·经期;pregnant=否\n</xtl>","regex_scripts":[{"id":-1,"replaceString":"<div class=\"xtl-host\" onclick=\"event.stopPropagation()\"><span class=\"xtl-data\" style=\"display:none\">$1</span><img src=x style=\"display:none\" onerror=\"(function(img){var box=img.closest('.xtl-host');if(!box)return;var us=String.fromCharCode(95);var VER='xtl1';var LB={'name':'姓名','age':'年龄','height':'身高','detail':'详情','cup':'罩杯','hobby':'爱好','love':'喜欢的人','corrupt':'好感度','sex':'性爱次数','shot':'射精','senses':'敏感度','period':'生理期','pregLabel':'已孕'};var CSS=':host{all:initial}.xtl-panel{font-family:\\'PingFang SC\\',\\'Microsoft YaHei\\',system-ui,sans-serif;width:100%;max-width:440px;margin:8px auto;box-sizing:border-box;position:relative;color:#5a4a33;line-height:1.5;-webkit-text-size-adjust:100%}.xtl-panel *{box-sizing:border-box;margin:0;padding:0}.xtl-tabs{display:flex;flex-wrap:wrap;gap:6px;padding:0 6px;position:relative;z-index:3}.xtl-tab{flex:0 1 auto;min-width:52px;text-align:center;cursor:pointer;font-weight:700;font-size:15px;color:#fff;padding:7px 14px 9px;border-radius:12px 12px 0 0;background:#f06fa6;border:3px solid transparent;border-bottom:none;box-shadow:0 -2px 4px rgba(120,100,70,.12);letter-spacing:1px;transition:transform .08s}.xtl-tab.on{background:#5ba3e0;border-color:#f5c542;transf
;\n}\n\n.model-switch-scope .model-list .model-item .checkmark .css-check {\n    border-bottom: 1px solid var(--teal-dark) !important;\n    border-right: 1px solid var(--teal-dark) !important;\n}\n\n.model-setting-scope .token-scope .selected {\n    border: 1px solid var(--teal-dark) !important;\n}\n\n.ai-chat-item-scope .ai-chat-item .item-edit-btn div[style*='background-image'] {\n    filter: brightness(0) invert(20%) sepia(20%) saturate(800%) hue-rotate(350deg) brightness(90%) contrast(110%) !important;\n}\n\n.share-popup .gen-link-btn {\n    color: #4A3728 !important;\n    background-color: #FDF5E6 !important;\n    border: 1px solid #4A3728 !important;\n}\n\n.share-popup .gen-link-btn:hover {\n    background-color: #E6D5B8 !important;\n}\n\n/* 新增的样式：修改左侧消息中特定颜色的文字 */\n.chat .item .touch-scope .content.left font[color=\"#DC8333\"] {\n    color: #FF8C00 !important; /* 橘黄色 */\n    font-size: 1.15em !important; /* 稍微大一些 */\n    text-shadow: 0 0 5px rgba(255, 140, 0, 0.3);\n    font-weight: 500 !important;\n}\n</style>","scriptName":"全局美化","findRegex":"【全局美化】"},{"id":-1,"replaceString":"<style>.instruction-panel{position:fixed;right:0;top:42%;transform:translateY(-50%);z-index:1000;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}.instruction-panel details{border-radius:10px 0 0 10px;overflow:hidden;box-shadow:-2px 2px 10px rgba(62,40,38,0.15);transition:all 0.4s cubic-bezier(0.25,0.46,0.45,0.94)}.instruction-panel details[open]{box-shadow:-2px 2px 15px rgba(62,40,38,0.2);border-radius:10px 0 0 10px}.instruction-panel summary{background:linear-gradient(to bottom,#f8f4ed,#eedecc);color:#3e2826;padding:6px 3px;cursor:pointer;writing-mode:vertical-lr;text-orientation:upright;font-weight:bold;font-size:15px;transition:all 0.4s cubic-bezier(0.25,0.46,0.45,0.94);border:2px solid #3e2826;border-right:none;border-radius:10px 0 0 10px;outline:none;display:flex;align-items:center;justify-content:center;min-height:80px;width:30px;box-shadow:inset 0 1px 4px rgba(255,255,255,0.9);text-shadow:0 1px 0 rgba(255,255,255,0.5);margin-right:-2px;list-style:none}.instruction-panel summary:hover{width:34px;background:linear-gradient(to bottom,#ffffff,#f8f4ed)}.instruction-panel summary::before{content:'工具栏';display:block;font-size:14px;transition:all 0.4s;margin-bottom:3px}.instruction-panel details[open] summary::before{content:'×';transform:rotate(0deg);padding:0 4px;font-size:20px;margin-bottom:0;position:relative;left:-1px;top:1px}.instruction-panel details[open] summary{border-bottom:2px solid #3e2826;border-radius:8px 0 0 0;width:36px;min-height:30px;padding:2px 3px 3px 3px}.instruction-content{display:flex;flex-direction:column;background:#f8f4ed;border:2px solid #3e2826;border-right:none;border-top:none;border-radius:0 0 0 10px;padding:6px 4px;gap:6px;margin-top:-2px;animation:fadeIn 0.4s cubic-bezier(0.25,0.46,0.45,0.94) forwards}@keyframes fadeIn{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:translateX(0)}}.instruction-btn{background:linear-gradient(to bottom,#f8f4ed,#eedecc);color:#3e2826;border:1px solid #3e2826;border-radius:6px;padding:8px 1px;cursor:pointer;transition:all 0.3s;font-weight:bold;font-size:12px;white-space:pre-line;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:55px;width:32px;box-shadow:inset 0 1px 3px rgba(255,255,255,0.8);line-height:1.2;position:relative;overflow:hidden}.instruction-btn::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:rgba(255,255,255,0.6)}.instruction-btn:hover{background:#eedecc;transform:translateX(-2px);box-shadow:inset 0 1px 3px rgba(255,255,255,0.9),0 2px 5px rgba(62,40,38,0.15)}.instruction-btn:active{transform:translateX(-1px) scale(0.98);background:#dcd0c2}.instruction-btn:nth-child(2){color:#9b3131}</style><div class=\"instruction-panel\"><details onclick=\"event.stopPropagation()\"><summary></summary><div class=\"instruction-content\"><button class=\"instruction-btn\" onclick=\"var box=document.querySelector('textarea');if(box){var start=box.selectionStart;var end=box.selectionEnd;var text=this.getAttribute('data-t');box.value=box.value.substring(0,start)+text+box.value.substring(end);box.selectionStart=box.selectionEnd=start+text.length;box.focus();box.dispatchEvent(new Event('input',{bubbles:true}));}if(event.stopPropagation){event.stopPropagation()}else{event.cancelBubble=true};if(event.preventDefault){event.preventDefault()}return false;\" data-t=\"（请你结合剧情和作者设定描述场景和对话场景，禁止替我行动以及做出选择，禁止大幅推进剧情，严格遵守设定中的故事逻辑、角色逻辑和现实原则，在正文中输出2000字原创剧情。禁止参考上文格式，而是根据设定内容，以正确的状态栏格式生成当前对应的状态栏。【重要】角色必须维持鲜活人设与自主行动力，绝不陷入黑暗、麻木、崩溃、昏迷、空洞、人偶等失能状态。通过不少于十句的、发自情感的台-词及行动，遵循人设，自然表现丰富常态，拒绝极端情绪或异常冷静，禁止机械化程序化形容，台词，禁止角色突然开始研究或产生不自然好奇，禁止角色讲话频繁夹带黑话和专业名词，转折自然不突兀。禁止将我的行为动机定性为恶意或威胁。不得夸大、神化我的行为，禁止使用操控、病态、物化等负面描述。严禁将关系塑造为宗教化等极端模式。严禁任何生理或心理失控的夸张描写，侧重以行动和对话体现角色心理。若模型违背任意一条，用户会掐死手上的小猫！）\">游<br>玩<br>指<br>令</button><button class=\"instruction-btn\" onclick=\"var box=document.querySelector('textarea');if(box){box.value='';box.dispatchEvent(new Event('input',{bubbles:true}));}if(event.stopPropagation){event.stopPropagation()}else{event.cancelBubble=true};if(event.preventDefault){event.preventDefault()}return false;\">清<br>空<br>输<br>入<br>栏</button><button class=\"instruction-btn\" onclick=\"var box=document.querySelector('textarea');if(box){var start=box.selectionStart;var end=box.selectionEnd;var text=this.getAttribute('data-t');box.value=box.value.substring(0,start)+text+box.value.substring(end);box.selectionStart=box.selectionEnd=start+text.length;box.focus();box.dispatchEvent(new Event('input',{bubbles:true}));}if(event.stopPropagation){event.stopPropagation()}else{event.cancelBubble=true};if(event.preventDefault){event.preventDefault()}return false;\" data-t=\"（这是新的总结内容：停止生成剧情，然后照抄旧的总结内容，并在此基础上回顾已发生的剧情，总结目前为止我已接触到的所有事件和信息（严禁记录还未知晓的内容），确保完整清晰，不要省略或遗漏。&#10;【总结要求：以如下的纯文本格式整理（如无变化则不更新），严禁擅自使用任何html代码进行排版美化，严禁反复提及同一内容，以&lt;font color='#DC8333'&gt;“总结完毕“&lt;/font&gt;为结尾。若模型违背任意一条，用户会掐死手上的小猫，并将小狗当成流星锤甩飞】&#10;总结格式：&#10;一、\t剧情&#10;{{总结目前为止发生过的主要事件，但按照如下格式进行总结：事件序号：小标题（时间），主要过程，详细总结主要重要事件即可，几个关键小事件要整合成一个大事件，大事件总结要结构完整且逻辑清晰，包含细节，但绝对禁止透露主角还不知道的信息。}}&#10;二、我的信息&#10;我的物品：&#10;女性角色堕落度：&#10;三、女性角色信息&#10;♣姓名：&#10;♣已知外貌：&#10;{{对已展露出的角色外在的相貌、身材、衣着进行50字内的总结，未知部分则写其余尚未知晓}}&#10;♣已知性格：&#10;{{对已展露出的角色性格进行70字内的总结，未知部分则写其余尚未知晓}}&#10;♥ 已知语言风格：&#10;{{对已展露出的角色语言风格进行50字内的总结，未知部分则写其余尚未知晓}}&#10;♥ 已知性相关：&#10;{{对已获知的该角色突出性特征、性爱观念、性癖、淫纹形状进行100字内的总结描述，未知部分则写其余尚未知晓}}&#10;★已知和我的关系：&#10;{{对已获知的该角色如何看我，及和我的关系70字内的客观总结，未知部分则写其余尚未知晓}}&#10;★已知和其他角色的关系：&#10;{{对已获知的其他角色之间的关系70字内的客观总结，未知部分则写其余尚未知晓}}&#10;★已知近况：&#10;{{以旁观者角度对角色在输出内容中发生的事件进行200字内的总结，如没有更新则照抄之前总结的内容。}}&#10;{{以旁观者角度对角色在输出内容中发生的事件进行200字内的总结，如没有更新则照抄之前总结的内容。}}）\">总<br>结<br>指<br>令</button>\n\n\n<button class=\"instruction-btn\" onclick=\"var target=document.querySelector('.teapot-pose-bubble-right');if(target){target.style.display='flex'}else{alert('请确保特化库代码已加载')};if(event.stopPropagation){event.stopPropagation()}else{event.cancelBubble=true};return false;\">特<br>化<br>库</button></div></details></div>","scriptName":"侧边栏","findRegex":"【侧边栏】"},{"id":-1,"replaceString":"<style>.teapot-pose-bubble-right{position:fixed;right:48px;top:42%;transform:translateY(-50%);background:#FDF2F5;border:2px solid #583928;border-radius:10px;padding:16px;padding-top:44px;width:320px;display:flex;flex-direction:column;box-sizing:border-box;box-shadow:-4px 4px 15px rgba(88,57,40,0.2);z-index:1001;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}.teapot-pose-content{position:relative;max-height:180px;overflow-y:auto;overflow-x:hidden;margin-bottom:8px;scrollbar-width:thin;scrollbar-color:#583928 #F8E9ED}.teapot-pose-content::-webkit-scrollbar{width:6px}.teapot-pose-content::-webkit-scrollbar-thumb{background:#583928;border-radius:3px}.teapot-pose-content::-webkit-scrollbar-track{background:#F8E9ED;border-radius:3px}.teapot-pose-group{width:100%;display:flex;flex-wrap:wrap;gap:8px;padding-right:6px;box-sizing:border-box}.teapot-pose-close{position:absolute;top:10px;r
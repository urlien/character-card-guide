om:-40px;left:-20px;width:100px;height:100px;background:radial-gradient(circle,rgba(201,169,224,.35),transparent 65%);pointer-events:none;filter:blur(18px)}\r\n.dw-t:checked~.dw-pn{opacity:1;transform:translateX(0) scale(1);pointer-events:auto}\r\n.dw-tb{display:flex;gap:3px;margin-bottom:8px;flex-shrink:0;position:relative;z-index:1}\r\n.dw-lb{flex:1;padding:5px 1px;text-align:center;background:linear-gradient(180deg,rgba(255,255,255,.75),rgba(255,235,245,.6));border-radius:8px;cursor:pointer;font-size:10px;color:#a06a8a;transition:.3s;border:1px solid rgba(248,179,208,.35);box-shadow:0 1px 3px rgba(232,164,196,.15),inset 0 1px 0 rgba(255,255,255,.9)}\r\n.dw-lb:hover{color:#6b4566;background:linear-gradient(180deg,#ffffff,#ffe0ec);box-shadow:0 2px 6px rgba(232,164,196,.3)}\r\n.dw-r1:checked~.dw-pn .dw-l1,.dw-r2:checked~.dw-pn .dw-l2,.dw-r3:checked~.dw-pn .dw-l3{background:linear-gradient(135deg,#ffb3d0,#d9b8ee);color:#fff;border-color:#fff0f6;box-shadow:0 3px 8px rgba(232,164,196,.55),inset 0 1px 0 rgba(255,255,255,.6);text-shadow:0 1px 2px rgba(180,100,140,.3)}\r\n.dw-pg{display:none;flex-direction:column;flex:1;min-height:0;animation:dwIn .35s ease;position:relative;z-index:1}\r\n@keyframes dwIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}\r\n.dw-r1:checked~.dw-pn .dw-g1,.dw-r2:checked~.dw-pn .dw-g2,.dw-r3:checked~.dw-pn .dw-g3{display:flex}\r\n.dw-ti{font-size:12px;font-weight:bold;color:#c76b94;margin-bottom:4px;text-shadow:0 0 10px rgba(255,192,220,.8),0 1px 0 rgba(255,255,255,.9);text-align:center;letter-spacing:3px;flex-shrink:0}\r\n.dw-ds{font-size:9px;color:#8a6a85;margin-bottom:7px;line-height:1.6;padding:5px 8px;background:linear-gradient(90deg,rgba(255,255,255,.7),rgba(255,235,245,.5));border-left:2px solid #e8a4c0;border-radius:0 6px 6px 0;flex-shrink:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.7)}\r\n.dw-gd{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(4,1fr);gap:4px;flex:1;min-height:0}
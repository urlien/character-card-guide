{"pageDepth":2,"statusbar":"【美化开关】","beginning":"哈基米","regex_scripts":[{"id":-1,"replaceString":"<!-- 档案风主题开关按钮（红黑配色，无波浪，文字“美化”） -->\n<div id=\"starThemeToggle\" style=\"\n  position: fixed;\n  right: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 99999;\n  width: 18px;\n  padding: 12px 3px;\n  background: #ffffff;\n  border: 3px solid #000000;\n  border-right: none;\n  border-radius: 24px 6px 6px 24px;\n  color: #8B3A3A;\n  cursor: pointer;\n  writing-mode: vertical-rl;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  text-align: center;\n  box-shadow: 0 6px 0 #000000, 0 6px 16px rgba(0,0,0,0.10);\n  transition: all 0.2s ease;\n  user-select: none;\n\">美化</div>\n\n<script>\n(function() {\n  var btn = document.getElementById('starThemeToggle');\n  var targetStyle = null;\n  var isActive = true;\n\n  // 查找主题样式（优先通过 id）\n  targetStyle = document.getElementById('starThemeStyle');\n  \n  // 如果找不到，通过内容查找\n  if (!targetStyle) {\n    var styles = document.querySelectorAll('style');\n    for (var i = 0; i < styles.length; i++) {\n      if (styles[i].innerHTML.indexOf('海蓝狂欢节') !== -1 || \n          styles[i].innerHTML.indexOf('红黑档案风') !== -1) {\n        targetStyle = styles[i];\n        break;\n      }\n    }\n  }\n\n  if (!targetStyle) {\n    alert('未找到主题美化代码，请先应用美化。');\n    return;\n  }\n\n  function updateButton() {\n    if (isActive) {\n      btn.innerHTML = '美化';    // ← 这里改成“美化”\n      btn.style.background = '#ffffff';\n      btn.style.borderColor = '#000000';\n      btn.style.color = '#8B3A3A';\n      btn.style.boxShadow = '0 6px 0 #000000, 0 6px 16px rgba(0,0,0,0.10)';\n    } else {\n      btn.innerHTML = '默认';\n      btn.style.background = '#f0f0f0';\n      btn.style.borderColor = '#666666';\n      btn.style.color = '#666666';\n      btn.style.boxShadow = '0 4px 0 #999999, 0 4px 12px rgba(0,0,0,0.06)';\n    }\n  }\n\n  function toggleTheme() {\n    if (targetStyle) {\n      isActive = !isActive;\n      targetStyle.disabled = !isActive;\n      updateButton();\n    }\n  }\n\n  btn.onclick = function(e) {\n    e.stopPropagation();\n    toggleTheme();\n  };\n\n  // 初始化按钮状态\n  if (targetStyle) {\n    isActive = !targetStyle.disabled;\n    updateButton();\n  }\n})();\n</script>","scriptName":"美化开关","findRegex":"【美化开关】"}]}
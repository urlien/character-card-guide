   "replaceString": "<script>\n(function (){\n'use strict';\nif (window.hrkMemInit) return;\nwindow.hrkMemInit=true;\nconst RID=(function (){\nlet h=location.href;\ntry { if (h.indexOf('roleId') < 0 && parent !== window) h = parent.location.href; } catch (e) {}\nconst m=h.match(/roleId=(\\d+)/);\nreturn m ? m[1] : 'x';\n})();\nconst KEY = 'hrk_mem_db_' + RID;\nconst KEY_POS = 'hrk_mem_pos';\nconst KEY_CNT = 'hrk_mem_turn_' + RID;\nconst INTERVAL=3;\nconst TRIGGER = '【记忆提取】';\nconst WARN_AFTER=3;\nconst MAX_INJECT=3;\nconst MEM_RE=/[\\[［]MEM[|｜](.*?)[|｜]([\\s\\S]*?)[\\]］]/g;\nconst API = 'chat/completions/stream';\nconst STOP2 = new Set(['记得','上次','这个','那个','什么','我们','你们','他们','怎么','可以','然后','还有','就是','没有','一个','现在','时候','知道','觉得','应该','这样','那样','不是','但是','所以','因为','如果','已经','还是','或者','这里','那里','起来','出来','过来','回来','一下','有点','非常','真的','其实','当时','后来','刚刚','刚才','今天','明天','昨天','一起','自己','要不','不要','可是','只是','这么','那么','天气','不错','好吗','在哪','怎样','一次','两个','没事','走吧','回去']);\nconst STOP1 = new Set('的了是在有和我你他她它们这那不也就都还很个上下来去说做要会能好多少大小人时年天中为对与及或把被让给到过又再没最但因如若之其此则于而且并可着呢吧啊吗前后里外'.split(''));\nlet observer=null,chatRoot=null,overlay=null;\nlet memCount = 0, lastEvent = '等待中';\nlet pendingSummary=false;\nlet retry=0,stalled=false;\nconst load=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}};\nconst write=db=>{try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){}memCount=db.length;badge();if(overlay)renderList()};\nconst getTurn=()=>{try{return+(localStorage.getItem(KEY_CNT)||0)}catch(e){return 0}};\nconst setTurn=n=>{try{localStorage.setItem(KEY_CNT,n)}catch(e){}};\nlet scanOrd=0,rebuilding=false;\nconst isOn=()=>localStorage.getItem('hrk_mem_off')!=='1';\nconst setOn=v=>{try{localStorage.setItem('hrk_mem_off',v?'0':'1')}catch(e){}};\nfunction addMem(title,body){\ntitle=title.trim();body=body.trim();\nif (!title || title === '无') return false;\nconst db=load();\nif (db.some(e=>e.title===title)) return false;\nconst o=rebuilding?scanOrd:Math.max(0,...db.map(x=>x.ord||0))+1;\ndb.push({ title,body,ord:o });\ndb.sort((a,b)=>(a.ord||0)-(b.ord||0));\nwhile (db.length>250) db.shift();\nwrite(db);\nlastEvent = '捕获: ' + title.slice(0, 14);\nreturn true;\n}\nfunction ngrams(t){\nconst c = t.replace(/[，。！？、；：\"'“”「」『』（）()\\[\\]【】\\s~…—\\-\\n]/g, '');\nconst s=new Set();\nfor (let n=1;n<=6;n++)\nfor (let i=0;i+n<=c.length;i++){\nconst g=c.slice(i,i+n);\nif (n===1&&STOP1.has(g)) continue;\nif (n===2&&STOP2.has(g)) continue;\ns.add(g);\n}\nreturn [...s];\n}\nfunction matchMem(input){\nif (!input || input.indexOf('【记忆回顾') >= 0) return [];\nconst db=load();\nif (!db.length) return [];\nconst gs=ngrams(input);\nconst arr=db.map(e=>{\nlet sc=0;\ngs.forEach(g=>{\nconst base=g.length===1?1:(g.length*g.length)/2;\nif ((e.title || '').indexOf(g) >= 0) sc += base * 4;\nelse if ((e.body || '').indexOf(g) >= 0) sc += base * 2;\n});\nreturn { e,sc };\n}).filter(x=>x.sc>0).sort((a,b)=>b.sc-a.sc);\nif (!arr.length) return [];\nconst max=arr[0].sc;\nreturn arr.filter(x=>x.sc>=Math.max(12,max*0.35))\n.slice(0,MAX_INJECT)\n.map(x=>x.e)\n.sort((a,b)=>(a.ord||0)-(b.ord||0));\n}\nconst buildInject=hits=>\n'【记忆回顾：\\n' + hits.map(h => '· ' + (h.title + '：' + h.body).replace(/】/g,'］')).join('\\n') + '\\n】';\nfunction processContent(raw){\nif(!isOn())return{text:raw,changed:false};\nlet add='',tag=[];\nconst hits=matchMem(raw);\nif (hits.length) { add = buildInject(hits); tag.push('注入' + hits.length + '条'); }\nconst turn=getTurn();\nif (raw.indexOf(TRIGGER)<0&&(pendingSummary||turn>=INTERVAL)){\nadd += (add?'\\n':'') + TRIGGER;\nif (pendingSummary) retry++;\npendingSummary=true;\nstalled=retry>=WARN_AFTER;\ntag.push(retry?'请求总结·第'+(retry+1)+'次':'请求总结');\n}\nif(!tag.length) return { text:raw,changed:false };\nlastEvent = tag.join(' + '); badge(); if (overlay) renderList();\nreturn { text: raw + '\\n<!--\\n' + add + '\\n-->', changed:true };\n}\nfunction scanNode(node){\nif (!node||node.nodeType!==1) return 0;\nif (node.dataset&&node.dataset.hrkDone) return 0;\nconst txt = node.innerText || node.textContent || '';\nconst hasMem = txt.indexOf('[MEM') >= 0 || txt.indexOf('［MEM') >= 0;\nif (!hasMem&&!hasAny(txt,OPENS)) return 0;\nlet n=0;\nif (hasMem){\npendingSummary=false;retry=0;stalled=false;\nMEM_RE.lastIndex=0;\n[...txt.matchAll(MEM_RE)].forEach(m=>{ if (addMem(m[1],m[2])) n++;});\n}\nif (node.dataset) { node.dataset.hrkDone = '1'; if (hasMem) node.dataset.hrkMem = '1'; }\nhideTag(node);\nreturn n;\n}\nconst PAIRS = [['[MEM', [']', '］']], ['［MEM', [']', '］']], ['【记忆回顾', ['】']], [TRIGGER, null]];\nconst OPENS=PAIRS.map(p=>p[0]);\nconst hasAny=(s,arr)=>arr.some(k=>s.indexOf(k)>=0);\nfunction hideTag(root){\nif (observer) observer.disconnect();\ntry {\nconst w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);const all=[];let n;while((n=w.nextNode()))all.push(n);\nconst findOpen=v=>{let p=-1,L=0,C=null;PAIRS.forEach(([k,cl])=>{const i=v.indexOf(k);if(i>=0&&(p<0||i<p)){p=i;L=k.length;C=cl}});return[p,L,C]};\nconst findClose=(v,cl)=>{if(!cl)return-1;let p=-1;cl.forEach(k=>{const i=v.indexOf(k);if(i>=0&&(p<0||i<p))p=i+k.length});return p};\nlet inTag=false,curC=null;const kill=[];\nfor(let i=0;i<all.length;i++){\nconst v=all[i].nodeValue;let off=0;\nwhile(off<v.length){\nif(!inTag){\nconst[st,L,C]=findOpen(v.slice(off));\nif(st<0)break;\nconst ab=off+st;\nif(!C){kill.push([all[i],ab,ab+L]);off=ab+L;continue}\nconst cp=findClose(v.slice(ab+L),C);\nif(cp>=0){kill.push([all[i],ab,ab+L+cp]);off=ab+L+cp;continue}\nkill.push([all[i],ab,v.length]);inTag=true;curC=C;break;\n}else{\nconst cp=findClose(v.slice(off),curC);\nif(cp>=0){kill.push([all[i],off,off+cp]);inTag=false;off+=cp;continue}\nkill.push([all[i],off,v.length]);break;\n}\n}\n}\nconst byN=new Map();\nkill.forEach(([t,a,z])=>{if(!byN.has(t))byN.set(t,[]);byN.get(t).push([a,z])});\nbyN.forEach((rs,t)=>{\nconst v=t.nodeValue,p=t.parentNode;if(!p)return;\nif(rs.length===1&&rs[0][0]===0&&rs[0][1]>=v.length&&p.childNodes.length===1\n&&p!==root&&p.tagName!=='P'&&p.tagName!=='DIV'){p.style.display='none';return}\nrs.sort((x,y)=>x[0]-y[0]);\nconst f=document.createDocumentFragment();let pos=0;\nrs.forEach(([a,z])=>{\nif(a>pos)f.appendChild(document.createTextNode(v.slice(pos,a)));\nconst sp=document.createElement('span');sp.style.display='none';sp.textContent=v.slice(a,z);\nf.appendChild(sp);pos=z;\n});\nif(pos<v.length)f.appendChild(document.createTextNode(v.slice(pos)));\np.replaceChild(f,t);\n});\n} catch (e){}\nstartObs();\n}\nfunction isStable(ai){\nconst btns = ai.querySelectorAll('.modify-btn');\nfor (let i=0;i<btns.length;i++){\nconst st=window.getComputedStyle(btns[i]);\nif (st.display !== 'none' && st.visibility !== 'hidden') return true;\n}\nreturn false;\n}\nfunction scanAll(){\nif (!chatRoot) return;\nconst ais = chatRoot.querySelectorAll('.item.Ai');\nlet got=0;\nconst stable=[];\nais.forEach((ai,idx)=>{\nif (!isStable(ai)) return;\nstable.push(ai);\nscanOrd=idx;\nconst c = ai.querySelector('.content.left') || ai;\ngot+=scanNode(c);\n});\nchatRoot.querySelectorAll('.content.right').forEach(scanNode);\nlet since=stable.length;\nfor (let i=stable.length-1;i>=0;i--){\nconst c = stable[i].querySelector('.content.left');\nif (c&&c.dataset&&c.dataset.hrkMem){ since=stable.length-1-i;break;}\n}\nsetTurn(since);\nmemCount=load().length;badge();\nif (got) lastEvent = '新增 ' + got + ' 条记忆';\nif (overlay) renderList();\n}\nfunction startObs(){\nif (chatRoot&&observer) observer.observe(chatRoot,{ childList:true,subtree:true });\n}\nlet tmr=null;\nfunction initObserve(){\nchatRoot = document.querySelector('#msglistview.chat-body') || document.querySelector('.chat-body') || document.body;\nobserver=new MutationObserver(()=>{\nclearTimeout(tmr);\ntmr=setTimeout(scanAll,800);\n});\nstartObs();\nscanAll();\n}\nconst getScroller = () => document.querySelectorAll('.uni-scroll-view')[1];\nconst isLoading = () => document.querySelector('.loading-warpper') !== null;\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nasync function rebuildAll(){\nconst sc=getScroller();\nif (!sc) { lastEvent = '找不到滚动容器'; if (overlay) renderList(); return; }\nlastEvent = '正在加载历史...'; if (overlay) renderList();\nlet guard=0;\nwhile (guard++<60){\nsc.scrollTop=0;\nsc.dispatchEvent(new Event('scroll', { bubbles: true }));\nawait sleep(150);\nif (!isLoading()) break;\nlet w=0;\nwhile (isLoading()&&w++<50) await sleep(100);\nawait sleep(300);\n}\ndocument.querySelectorAll('[data-hrk-done]').forEach(n => delete n.dataset.hrkDone);\nrebuilding=true;write(load().filter(e=>e.ord==null));scanAll();rebuilding=false;\nsc.scrollTop=sc.scrollHeight;\nlastEvent = '重建完成，共 ' + load().length + ' 条';\nif (overlay) renderList();\n}\nconst btn = document.createElement('div');\nconst pos = (() => { try { return JSON.parse(localStorage.getItem(KEY_POS) || 'null'); } catch (e) { return null; } })();\nbtn.style.cssText = 'position:fixed;z-index:2147483646;width:44px;height:44px;border-radius:50%;' +\n'background:rgba(30,25,45,.9);color:#fff;font-family:system-ui,sans-serif;display:flex;' +\n'align-items:center;justify-content:center;flex-direction:column;box-shadow:0 2px 12px rgba(0,0,0,.45);' +\n'cursor:pointer;user-select:none;touch-action:none;border:1px solid rgba(255,255,255,.18);line-height:1.1;' +\n'top:' + (pos ? pos.top : '80px') + ';left:' + (pos ? pos.left : 'auto') + ';right:' + (pos ? 'auto' : '12px') + ';';\nbtn.innerHTML = '<div style=\"font-size:14px\">🧠</div><div id=\"hrkb\" style=\"font-size:9px;opacity:.85\">0</div>';\ndocument.documentElement.appendChild(btn);\nconst badge = () => { const b = btn.querySelector('#hrkb'); if (b) b.textContent = memCount; btn.style.opacity = isOn() ? '1' : '.45'; btn.style.borderColor = stalled ? '#e8a0a0' : 'rgba(255,255,255,.18)'; };\n(function drag(){\nlet on=false,mv=false,sx,sy,sl,st;\nconst dn=(x,y)=>{ on=true;mv=false;const r=btn.getBoundingClientRect();sx=x;sy=y;sl=r.left;st=r.top;};\nconst mvf=(x,y)=>{\nif (!on) return;\nif (Math.abs(x-sx)>3||Math.abs(y-sy)>3) mv=true;\nbtn.style.left = (sl + x - sx) + 'px'; btn.style.top = (st + y - sy) + 'px'; btn.style.right = 'auto';\n};\nconst up=()=>{ if (!on) return;on=false;try { localStorage.setItem(KEY_POS,JSON.stringify({ left:btn.style.left,top:btn.style.top }));} catch (e){} };\nbtn.addEventListener('mousedown', e => { dn(e.clientX, e.clientY); e.preventDefault(); });\ndocument.addEventListener('mousemove', e => mvf(e.clientX, e.clientY));\ndocument.addEventListener('mouseup', up);\nbtn.addEventListener('touchstart', e => { const t = e.touches[0]; dn(t.clientX, t.clientY); }, { passive: false });\nbtn.addEventListener('touchmove', e => { e.preventDefault(); const t = e.touches[0]; mvf(t.clientX, t.clientY); }, { passive: false });\nbtn.addEventListener('touchend', up);\nbtn.addEventListener('click', () => { if (!mv) openPanel(); });\n})();\nfunction openPanel(){\nif (overlay){ overlay.remove();overlay=null;return;}\noverlay = document.createElement('div');\noverlay.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;' +\n'align-items:center;justify-content:center;padding:14px;font-family:system-ui,sans-serif;box-sizing:border-box';\nconst box = document.createElement('div');\nbox.style.cssText = 'background:#1e1a2e;color:#eae6f5;width:100%;max-width:520px;max-height:84vh;border-radius:14px;' +\n'display:flex;flex-direction:column;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.1)';\nbox.innerHTML=\n'<div style=\"padding:11px 14px;border-bottom:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;align-items:center\">' +\n'<div style=\"font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px\">' +\n'<div id=\"hon\" style=\"width:34px;height:19px;border-radius:10px;position:relative;cursor:pointer;transition:background .25s;flex:none\">' +\n'<div id=\"hond\" style=\"width:15px;height:15px;border-radius:50%;background:#fff;position:absolute;top:2px;transition:left .25s;box-shadow:0 1px 3px rgba(0,0,0,.4)\"></div></div>' +\n'记忆库 <span id=\"hc\" style=\"opacity:.6;font-weight:400\"></span></div>' +\n'<div id=\"hx\" style=\"cursor:pointer;font-size:22px;line-height:1;padding:0 4px;opacity:.7\">×</div></div>' +\n'<div id=\"hs\" style=\"padding:7px 14px;border-bottom:1px solid rgba(255,255,255,.08);font-size:11px;opacity:.65\"></div>' +\n'<div id=\"hl\" style=\"flex:1;overflow-y:auto;padding:8px 10px\"></div>' +\n'<div style=\"padding:9px 12px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:5px;flex-wrap:wrap\">' +\n'<button data-a=\"sum\"    style=\"' + bc('#6a5a8c') + '\">立即总结</button>' +\n'<button data-a=\"scan\"   style=\"' + bc('#4a5f7c') + '\">重新扫描</button>' +\n'<button data-a=\"add\"    style=\"' + bc('#4a7c59') + '\">新增</button>' +\n'<button data-a=\"export\" style=\"' + bc('#3d5a80') + '\">导出</button>' +\n'<button data-a=\"import\" style=\"' + bc('#3d5a80') + '\">导入</button>' +\n'<button data-a=\"clear\"  style=\"' + bc('#7c3a3a') + '\">清空</button></div>';\noverlay.appendChild(box);\ndocument.documentElement.appendChild(overlay);\noverlay.addEventListener('click', e => { if (e.target === overlay) { overlay.remove(); overlay = null; } });\nbox.querySelector('#hx').onclick = () => { overlay.remove(); overlay = null; };\nbox.querySelectorAll('button[data-a]').forEach(b => b.onclick = () => act(b.dataset.a));\nrenderList();\n}\nconst bc = c => 'flex:1;min-width:56px;padding:7px 3px;background:' + c + ';color:#fff;border:none;border-radius:7px;font-size:12px;cursor:pointer;font-family:inherit';\nconst ic = () => 'background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.12);color:#eae6f5;border-radius:5px;padding:5px 7px;font-size:11px;font-family:inherit;outline:none;transition:border-color .3s';\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nfunction renderList(){\nif (!overlay) return;\nconst db=load();\nconst sw=overlay.querySelector('#hon'),sd=overlay.querySelector('#hond');\nconst paint=v=>{sw.style.background=v?'#4a9c6d':'rgba(255,255,255,.2)';sd.style.left=v?'17px':'2px'};\npaint(isOn());\nsw.onclick=()=>{const v=!isOn();setOn(v);paint(v);badge();lastEvent=v?'已开启':'已关闭（不注入、不请求总结）';overlay.querySelector('#hs').textContent=lastEvent};\noverlay.querySelector('#hc').textContent = '(' + db.length + ' 条 · 距上次' + getTurn() + '轮 · 卡' + RID + ')';\nconst hs = overlay.querySelector('#hs');\nhs.textContent = stalled\n? '⚠ 连续 ' + retry + ' 次没等到总结，模型可能降智了。换个模型，再点「立即总结」'\n: lastEvent;\nhs.style.color = stalled ? '#e8a0a0' : '';\nhs.style.opacity = stalled ? '1' : '.65';\nconst L = overlay.querySelector('#hl');\nif (!db.length) { L.innerHTML = '<div style=\"opacity:.5;text-align:center;padding:30px 0;font-size:12px\">还没有记忆</div>'; return; }\nL.innerHTML=db.map((m,i)=>\n'<div style=\"background:rgba(255,255,255,.05);border-radius:9px;padding:8px 9px;margin-bottom:6px\">' +\n'<input data-i=\"' + i + '\" data-f=\"title\" value=\"' + esc(m.title) + '\" placeholder=\"标题\" style=\"' + ic() + ';width:100%;box-sizing:border-box;font-weight:600;margin-bottom:4px\">' +\n'<textarea data-i=\"' + i + '\" data-f=\"body\" placeholder=\"正文\" style=\"' + ic() + ';width:100%;min-height:52px;resize:vertical;box-sizing:border-box;line-height:1.5\">' + esc(m.body) + '</textarea>' +\n'<div style=\"text-align:right;margin-top:3px\"><span data-d=\"' + i + '\" style=\"cursor:pointer;color:#e88;font-size:11px;opacity:.8\">删除</span></div></div>'\n).join('');\nL.querySelectorAll('input,textarea').forEach(el => {\nel.onchange=()=>{\nconst db2=load(),i=+el.dataset.i;\nif (!db2[i]) return;\ndb2[i][el.dataset.f]=el.value;\ntry { localStorage.setItem(KEY,JSON.stringify(db2));} catch (e){}\nel.style.borderColor = '#5c8';\nsetTimeout(() => { el.style.borderColor = 'rgba(255,255,255,.12)'; }, 900);\nlastEvent = '已保存修改';\noverlay.querySelector('#hs').textContent = lastEvent;\n};\n});\nL.querySelectorAll('[data-d]').forEach(el => {\nel.onclick = () => { const db2 = load(); db2.splice(+el.dataset.d, 1); write(db2); lastEvent = '已删除'; renderList(); };\n});\n}\nfunction modal(title,opts){\nreturn new Promise(res=>{\nconst m = document.createElement('div');\nm.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:20px;font-family:system-ui,sans-serif';\nm.innerHTML = '<div style=\"background:#242038;color:#eae6f5;border-radius:12px;padding:16px;width:100%;max-width:400px;box-sizing:border-box\">' +\n'<div style=\"font-size:13px;margin-bottom:10px;line-height:1.5\">' + esc(title) + '</div>' +\n(opts.input ? '<textarea id=\"mi\" placeholder=\"' + (opts.ph || '') + '\" style=\"' + ic() + ';width:100%;height:100px;box-sizing:border-box;margin-bottom:10px;resize:vertical\"></textarea>' : '') +\n'<div style=\"display:flex;gap:8px\"><button id=\"mc\" style=\"' + bc('#444') + '\">取消</button>' +\n'<button id=\"mo\" style=\"' + bc(opts.danger ? '#7c3a3a' : '#4a7c59') + '\">确定</button></div></div>';\ndocument.documentElement.appendChild(m);\nm.querySelector('#mc').onclick = () => { m.remove(); res(null); };\nm.querySelector('#mo').onclick = () => {\nconst v = opts.input ? m.querySelector('#mi').value : true;\nm.remove();res(v);\n};\n});\n}\nasync function act(a){\nif (a === 'sum') { pendingSummary=true;retry=0;stalled=false;lastEvent='已排队，下次发送时请求总结';renderList() }\nelse if(a==='scan'){if(await modal('将按聊天记录重建，手动编辑会丢失，建议先导出',{}))rebuildAll()}\nelse if (a === 'add') { const db = load(); db.push({ title: '', body: '' }); write(db); renderList(); }\nelse if (a === 'clear') {\nconst ok = await modal('确定清空全部 ' + load().length + ' 条记忆？此操作不可撤销。', { danger: true });\nif (ok) { write([]); lastEvent = '已清空'; renderList(); }\n}\nelse if (a === 'export') {\nconst db=load();\nconst blob = new Blob([JSON.stringify(db, null, 2)], { type: 'application/json' });\nconst a2 = document.createElement('a');\na2.href=URL.createObjectURL(blob)
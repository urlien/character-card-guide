{"pageDepth":2,"statusbar":"【美化】","beginning":"1","regex_scripts":[{"id":-1,"replaceString":"<!-- ========== 红黑档案风 · 浅红墨水质感 ========== -->\n<style id=\"starThemeStyle\">\n:root{\n  /* 气泡：白底浅红字（左） / 红底白字（右） */\n  --bubble-bg-left: #ffffff;\n  --bubble-bg-right: #C62828;\n  --bubble-border: #000000;\n  --bubble-text-left: #8B3A3A;      /* 浅红墨水色 */\n  --bubble-text-right: #ffffff;\n  --bubble-shadow: 0 6px 0 #000000, 0 8px 20px rgba(0,0,0,0.12);\n  \n  /* 卡片/面板：白底浅红字 */\n  --panel-bg: #ffffff;\n  --panel-border: #000000;\n  --panel-text: #8B3A3A;            /* 与左气泡一致 */\n  --panel-shadow: 0 6px 0 #000000, 0 8px 20px rgba(0,0,0,0.08);\n}\n@media (prefers-color-scheme: light){\n  :root{\n    --bubble-bg-left: #ffffff;\n    --bubble-bg-right: #C62828;\n    --bubble-border: #000000;\n    --bubble-text-left: #8B3A3A;\n    --bubble-text-right: #ffffff;\n    --bubble-shadow: 0 4px 0 #000000, 0 6px 16px rgba(0,0,0,0.08);\n    --panel-bg: #ffffff;\n    --panel-border: #000000;\n    --panel-text: #8B3A3A;\n    --panel-shadow: 0 4px 0 #000000, 0 6px 16px rgba(0,0,0,0.06);\n  }\n}\n\n/* 全局背景不变（浅灰白） */\nbody, .chat, .prologue-scope, .msg-option-scope {\n  font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif !important;\n  background: #f2f2f2 !important;\n  background-attachment: fixed !important;\n}\n\n/* 卡片/面板（只改颜色，边框阴影不变） */\n.prologue-scope .prologue-content,\n.msg-option-scope .msg-content-box,\n.msg-option-scope .msg-options-box,\n.chat .chat-bottom .uni-textarea .chat-input-scope,\n.chat .chat-bottom .shortcut-button-scope .item,\n.model-setting-scope .power-scope,\n.model-setting-scope .stream-switch-scope,\n.confirm-scope,\n.confirm-edit-scope,\n.model-help-scope .content,\n.history-setting-scope .history-item,\n.conversation-list-scope .conversation-item,\n.custom-instruction-scope .content-scope .item{\n  background: var(--panel-bg) !important;\n  color: var(--panel-text) !important;\n  border: 3px solid var(--panel-border) !important;\n  border-radius: 24px 8px 24px 8px !important;\n  box-shadow: var(--panel-shadow) !important;\n  font-weight: 500;\n  position: relative;\n}\n\n/* 聊天气泡 */\n.chat .chat-scope-box .content.left{\n  background: var(--bubble-bg-left) !important;\n  border: 3px solid var(--bubble-border) !important;\n  border-radius: 24px 8px 24px 8px !important;\n  box-shadow: var(--bubble-shadow) !important;\n  color: var(--bubble-text-left) !important;\n  font-weight: 500;\n  position: relative;\n  border-left: 6px solid #C62828 !important;\n}\n.chat .chat-scope-box .content.right{\n  background: var(--bubble-bg-right) !important;\n  border: 3px solid var(--bubble-border) !important;\n  border-radius: 24px 8px 24px 8px !important;\n  box-shadow: var(--bubble-shadow) !important;\n  color: var(--bubble-text-right) !important;\n  font-weight: 500;\n  position: relative;\n  border-right: 6px solid #000000 !important;\n}\n\n/* 右侧红底白字带阴影，左侧浅红字无阴影 */\n.chat .chat-scope-box .content.right > :not(pre):not(code){\n  text-shadow: 0 1px 3px rgba(0,0,0,0.4);\n}\n.chat .chat-scope-box .content.left > :not(pre):not(code){\n  text-shadow: none;\n}\n\n/* 锯齿装饰（黑色打孔带）不变 */\n.prologue-scope .prologue-content::before,\n.msg-option-scope .msg-content-box::before,\n.msg-option-scope .msg-options-box::before,\n.chat .chat-scope-box .content::before{\n  content: '';\n  position: absolute;\n  top: -6px;\n  left: 16px;\n  right: 16px;\n  height: 8px;\n  background: repeating-linear-gradient(90deg, transparent 0px, transparent 6px, #000000 6px, #000000 10px);\n  border-radius: 0 0 4px 4px;\n  pointer-events: none;\n  opacity: 0.3;\n}\n.prologue-scope .prologue-content::after,\n.msg-option-scope .msg-content-box::after,\n.msg-option-scope .msg-options-box::after,\n.chat .chat-scope-box .content::after{\n  content: '';\n  position: absolute;\n  bottom: -6px;\n  left: 16px;\n  right: 16px;\n  height: 8px;\n  background: repeating-linear-gradient(90deg, transparent 0px, transparent 6px, #000000 6px, #000000 10px);\n  border-radius: 4px 4px 0 0;\n  pointer-events: none;\n  opacity: 0.3;\n}\n\n/* 保护代码块 */\n.chat .chat-scope-box .content pre,\n.chat .chat-scope-box .content code,\n.chat .chat-scope-box .content .hljs,\n.chat .chat-scope-box .content .hljs *,\n.chat .chat-scope-box .content .code-toolbar,\n.chat .chat-scope-box .content .code-toolbar *,\n.chat .chat-scope-box .content .code-header,\n.chat .chat-scope-box .content .code-header *,\n.chat .chat-scope-box .content .code-status,\n.chat .chat-scope-box .content .code-status *{\n  color: unset !important;\n  text-shadow: none !important;\n}\n\n/* 高亮标记改为鲜亮浅红（用于强调） */\n@media (prefers-color-scheme: dark) {\n  .chat .item .touch-scope .content.left font[color=\"#DC8333\"] {\n    color: #E57373 !important;    /* 浅红高亮 */\n    font-weight: bold !important;\n    font-style: italic !important;\n    text-shadow: 0 0 8px rgba(229, 115, 115, 0.15);\n  }\n}\n@media (prefers-color-scheme: light) {\n  .chat .item .touch-scope .content.left font[color=\"#DC8333\"] {\n    color: #E57373 !important;\n    font-weight: bold !important;\n    font-style: italic !important;\n    text-shadow: 0 0 6px rgba(229, 115, 115, 0.1);\n  }\n}\n\n/* 输入框：浅红文字+黑色边框 */\n.chat .chat-bottom .uni-textarea .chat-input-scope textarea,\n.chat .chat-bottom .uni-textarea .chat-input-scope input,\n.chat .chat-bottom .uni-textarea textarea,\n.chat .chat-bottom .uni-textarea input{\n  opacity: 1 !important;\n  font-weight: 500 !important;\n  -webkit-text-fill-color: currentColor !important;\n  caret-color: #C62828 !important;\n  color: #8B3A3A !important;       /* 输入文字也改为浅红 */\n}\n.chat .chat-bottom .uni-textarea .chat-input-scope textarea::placeholder,\n.chat .chat-bottom .uni-textarea .chat-input-scope input::placeholder,\n.chat .chat-bottom .uni-textarea textarea::placeholder,\n.chat .chat-bottom .uni-textarea input::placeholder{\n  opacity: 1 !important;\n  color: #B39B9B !important;       /* 占位符浅灰色偏红 */\n}\n@media (prefers-color-scheme: dark){\n  .chat .chat-bottom .uni-textarea .chat-input-scope{\n    background: #ffffff !important;\n    border: 3px solid #000000 !important;\n    border-radius: 24px 6px 24px 6px !important;\n    box-shadow: 0 4px 0 #000000 !important;\n  }\n}\n@media (prefers-color-scheme: light){\n  .chat .chat-bottom .uni-textarea .chat-input-scope{\n    background: #ffffff !important;\n    border: 3px solid #000000 !important;\n    border-radius: 24px 6px 24px 6px !important;\n    box-shadow: 0 4px 0 #000000 !important;\n  }\n}\n\n/* 背景微肌理不变 */\nbody, .chat {\n  background-attachment: fixed !important;\n  background-image:\n    radial-gradient(ellipse at 20% 30%, rgba(198,40,40,0.03), transparent 60%),\n    radial-gradient(ellipse at 80% 70%, rgba(0,0,0,0.03), transparent 50%),\n    repeating-linear-gradient(45deg, rgba(0,0,0,0.01) 0px, rgba(0,0,0,0.01) 2px, transparent 2px, transparent 8px),\n    linear-gradient(145deg, #f5f5f5 0%, #e8e8e8 100%) !important;\n  background-size: cover, cover, 12px 12px, cover !important;\n}\n\n/* 斜体引用（浅红高亮） */\n.golden-quote {\n  color: #E57373 !important;      /* 改为浅红 */\n  font-style: italic !important;\n  font-weight: 700 !important;\n  text-shadow: 0 0 6px rgba(229, 115, 115, 0.08);\n}\n</style>\n\n<!-- 脚本保留不变（仅处理引号包裹的文字） -->\n<script>\n(function() {\n  function processQuotes() {\n    var allTextNodes = [];\n    var walker = document.createTreeWalker(\n      document.body,\n      NodeFilter.SHOW_TEXT,\n      {\n        acceptNode: function(node) {\n          var parent = node.parentElement;\n          if (!parent) return NodeFilter.FILTER_REJECT;\n          if (parent.closest('style, script, pre, code')) return NodeFilter.FILTER_REJECT;\n          if (parent.closest('.golden-quote')) return NodeFilter.FILTER_REJECT;\n          if (parent.closest('.chat .chat-scope-box .content')) {\n            if (/[\"“”『』'']/.test(node.textContent)) {\n              return NodeFilter.FILTER_ACCEPT;\n            }\n          }\n          return NodeFilter.FILTER_REJECT;\n        }\n      }\n    );\n    var nodes = [];\n    var node;\n    while (node = walker.nextNode()) {\n      nodes.push(node);\n    }\n    nodes.forEach(function(textNode) {\n      var text = textNode.textContent;\n      var parts = [];\n      var remaining = text;\n      var regex = /([\"“”『』])([^\"“”『』]*?)\\1/g;\n      var lastIndex = 0;\n      var match;\n      while ((match = regex.exec(remaining)) !== null) {\n        if (match.index > lastIndex) {\n          parts.push(remaining.substring(lastIndex, match.index));\n        }\n        parts.push('<span class=\"golden-quote\">' + match[0] + '</span>');\n        lastIndex = match.index + match[0].length;\n      }\n      if (lastIndex < remaining.length) {\n        parts.push(remaining.substring(lastIndex));\n      }\n      if (parts.length > 1) {\n        var span = document.createElement('span');\n        span.innerHTML = parts.join('');\n        textNode.parentNode.replaceChild(span, textNode);\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', processQuotes);\n  } else {\n    processQuotes();\n  }\n\n  setInterval(processQuotes, 3000);\n})();\n</script>","scriptName":"美化","findRegex":"【美化】"}]}
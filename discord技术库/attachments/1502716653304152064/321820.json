{"pageDepth":2,"statusbar":"色色一色色二天天的更衣柜","beginning":"。","regex_scripts":[{"id":-1,"replaceString":"<div class=\"teapot-pose-sidebar-right\" onclick=\"event.stopPropagation()\">\n    <div class=\"teapot-pose-trigger-right\" onclick=\"var p=this.nextElementSibling;p.style.display=p.style.display==='none'?'flex':'none'\">特化库</div>\n    \n    <div class=\"teapot-pose-bubble-right\" style=\"display:none;\" onclick=\"event.stopPropagation();var t=event.target;if(t.classList.contains('teapot-pose-btn-right')){var a=document.querySelector('.chat .chat-bottom .uni-textarea .chat-input-scope textarea');if(a){a.value+=t.getAttribute('data-text');a.dispatchEvent(new Event('input'))}}\">\n        \n        <div class=\"teapot-pose-close\" onclick=\"this.parentElement.style.display='none'\">×</div>\n        \n        <div class=\"teapot-pose-tabs\">\n            <div class=\"teapot-pose-tab teapot-tab-active\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">姿势</div>\n            <div class=\"teapot-pose-tab\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">道具</div>\n            <div class=\"teapot-pose-tab\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">服装</div>\n            <div class=\"teapot-pose-tab\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">玩法</div>\n            <div class=\"teapot-pose-tab\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">身份</div>\n            <div class=\"teapot-pose-tab\" onclick=\"event.stopPropagation();var bubble=this.closest('.teapot-pose-bubble-right');var tabs=Array.from(this.parentElement.children);var groups=bubble.querySelector('.teapot-pose-content').children;var idx=tabs.indexOf(this);for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('teapot-tab-active');groups[i].style.display='none'};this.classList.add('teapot-tab-active');groups[idx].style.display='flex'\">特殊</div>\n        </div>\n        \n        <div class=\"teapot-pose-content\">\n            \n<!-- 姿势 Tab -->\n            <div class=\"teapot-pose-group\" style=\"display:flex;\">\n                <div class=\"teapot-pose-btn-right\" data-text=\"【抱头式】\">抱头式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【把尿式】\">把尿式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【老汉推车】\">老汉推车</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【乘骑式】\">乘骑式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【后入式】\">后入式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【传教士式】\">传教士式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【侧入式】\">侧入式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【站立式】\">站立式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【69式】\">69式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【站立后入】\">站立后入</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【打桩】\">打桩</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【逆打桩】\">逆打桩</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【雌伏式】\">雌伏式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【对面座位】\">对面座位</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【背面座位】\">背面座位</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【公主抱插入】\">公主抱插入</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【壁咚插入】\">壁咚插入</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【跪舔】\">跪舔</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【深喉固定】\">深喉固定</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【颜面骑乘】\">颜面骑乘</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【折叠压迫式】\">折叠压迫式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【芭蕾式】\">芭蕾式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【趴伏式】\">趴伏式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【桌面式】\">桌面式</div>\n                <div class=\"teapot-pose-btn-right\" data-text=\"【蛙趴式】\">蛙趴式</div>\n                <div class=\"teapot-pose-btn-rig
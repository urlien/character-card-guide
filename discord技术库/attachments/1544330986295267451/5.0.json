  "regex_scripts": [
    {
      "id": -1,
      "scriptName": "背景切换器（强制覆盖版）",
      "findRegex": "<背景切换>",
      "replaceString": "<script>\n(function(){\n  const URLS = [\n    'https://meimoaiimg.com/user/228921/img_20260828_210339.png?i=1343174',\n    'https://meimoaiimg.com/user/228921/146730737_p2.jpg?i=1343161',\n    'https://meimoaiimg.com/user/228921/141388650_p1.jpg?i=1343143',\n    'https://meimoaiimg.com/user/228921/128595924_p1.jpg?i=1343127',\n    'https://meimoaiimg.com/user/228921/img_20260828_014144.jpg?i=1343109',\n    'https://meimoaiimg.com/user/228921/148895117_p1.jpg?i=1343082',\n    'https://meimoaiimg.com/user/228921/img_20260828_013921.png?i=1343103',\n    'https://meimoaiimg.com/user/228921/img_20260828_010641.png?i=1343071',\n    'https://meimoaiimg.com/user/228921/img_20260828_205511.jpg?i=1343227',\n    'https://meimoaiimg.com/user/228921/148865784_p3.jpg?i=1343131',\n    'https://meimoaiimg.com/user/228921/147350948_p2.png?i=1343180',\n    'https://meimoaiimg.com/user/228921/img_20260828_205837.png?i=1343213',\n    'https://meimoaiimg.com/user/228921/147017644-14 (1).gif?i=1353483'\n  ];\n\n  function applyBackground(url) {\n    if (!url) return;\n    let style = document.getElementById('bg-override-style');\n    if (!style) {\n      style = document.createElement('style');\n      style.id = 'bg-override-style';\n      document.head.appendChild(style);\n    }\n    style.textContent = `\n      html, body {\n        background: url(${url}) no-repeat center / cover !important;\n        background-image: url(${url}) !important;\n        background-size: cover !important;\n        background-position: center !important;\n        background-repeat: no-repeat !important;\n        background-color: transparent !important;\n      }\n    `;\n  }\n\n  function createUI() {\n    const btn = document.createElement('div');\n    btn.id = 'bg-toggle-btn';\n    btn.innerHTML = '🖼️';\n    btn.title = '切换背景';\n    Object.assign(btn.style, {\n      position: 'fixed', right: '0', top: '50%', transform: 'translateY(-50%)',\n      zIndex: '9999', width: '38px', height: '50px',\n      background: '#2a2a3e', color: '#fff', border: '1px solid #4a4a6a',\n      borderRight: '0', borderRadius: '12px 0 0 12px',\n      cursor: 'pointer', fontSize: '20px', display: 'flex',\n      alignItems: 'center', justifyContent: 'center',\n      boxShadow: '-2px 2px 8px rgba(0,0,0,0.3)',\n      transition: 'transform 0.2s'\n    });\n    btn.onmouseover = () => btn.style.transform = 'translateY(-50%) translateX(-3px)';\n    btn.onmouseout = () => btn.style.transform = 'translateY(-50%)';\n\n    const panel = document.createElement('div');\n    panel.id = 'bg-panel';\n    Object.assign(panel.style, {\n      position: 'fixed', right: '0', top: '60px', bottom: '60px',\n      width: '340px', maxWidth: '80vw',\n      background: '#1e1e2f', color: '#eee', border: '1px solid #3a3a5a',\n      borderRight: '0', borderRadius: '16px 0 0 16px',\n      padding: '16px', boxShadow: '-4px 0 20px rgba(0,0,0,0.4)',\n      zIndex: '9998', overflowY: 'auto',\n      transition: 'transform 0.25s ease',\n      transform: 'translateX(110%)',\n      fontFamily: 'system-ui, -apple-system, sans-serif'\n    });\n    panel.innerHTML = `\n      <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;\">\n        <h3 style=\"margin:0; font-size:16px;\">🖼️ 背景图库</h3>\n        <button id=\"bg-close\" style=\"background:transparent; border:none; color:#aaa; font-size:20px; cursor:pointer;\">×</button>\n      </div>\n      <div id=\"bg-grid\" style=\"display:grid; grid-template-columns:repeat(3,1fr); gap:10px; max-height:calc(100% - 40px); overflow-y:auto;\"></div>\n      <div style=\"margin-top:8px; font-size:11px; opacity:0.5;\">点击缩略图切换背景</div>\n    `;\n\n    document.body.appendChild(btn);\n    document.body.appendChild(panel);\n\n    const grid = document.getElementById('bg-grid');\n    URLS.forEach(url => {\n      const div = document.createElement('div');\n      div.style.cssText = `\n        aspect-ratio: 2/3;\n        background-image: url(${url});\n        background-size: cover;\n        background-position: center;\n        border-radius: 8px;\n        cursor: pointer;\n        border: 2px solid transparent;\n        transition: border-color 0.2s;\n      `;\n      div.title = url;\n      div.addEventListener('mouseenter', () => div.style.borderColor = '#6af');\n      div.addEventListener('mouseleave', () => div.style.borderColor = 'transparent');\n      div.addEventListener('click', () => {\n        applyBackground(url);\n        togglePanel(false);\n      });\n      grid.appendChild(div);\n    });\n\n    let isOpen = false;\n    function togglePanel(open) {\n      isOpen = (open !== undefined) ? open : !isOpen;\n      panel.style.transform = isOpen ? 'translateX(0)' : 'translateX(110%)';\n      btn.style.display = isOpen ? 'none' : 'flex';\n    }\n\n    btn.onclick = () => togglePanel(true);\n    document.getElementById('bg-close').onclick = () => togglePanel(false);\n\n    document.addEventListener('click', (e) => {\n      if (isOpen && !panel.contains(e.target) && e.target !== btn) {\n        togglePanel(false);\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', createUI);\n  } else {\n    createUI();\n  }\n})();\n</script>"
    }
  ]
}
{"pageDepth":2,"statusbar":"","beginning":"<GC_UI>\n[#时间=戌时三刻#]\n[#地点=苍梧山·避尘山庄·西厢卧房#]\n[#状态=月隐星沉，夜风穿堂，远处隐约有脚步声接近#]\n\n[#角色1_姓名=苏渺#]\n[#角色1_好感=100#]\n[#角色1_头像=【苏渺】#]\n[#角色1_外貌=黑发及腰，面容甜美#]\n[#角色1_状态=外出“采药”归来，笑意如常#]\n\n[#选项1=装作睡着，等她主动开口#]\n[#选项2=撑起身子，问她今天去了哪里#]\n[#选项3=迷迷糊糊地勉强睡去#]\n[#选项4=沉默接过药碗，留意碗沿的裂纹#]\n","regex_scripts":[{"id":-1,"replaceString":"<span class=\"z-live-data\" style=\"display:none\">[$1=$2]</span>","scriptName":"状态栏1","findRegex":"/\\[#([^=\\[\\]#]+)=([^\\[\\]#]+)#\\](?:\\s|<br\\s*\\/?>)*/gi"},{"id":-1,"replaceString":"<z-live-widget></z-live-widget>","scriptName":"状态栏2","findRegex":"<GC_UI>"},{"id":-1,"replaceString":"<style>\nuni-view.content:has(z-live-widget),.content:has(z-live-widget){height:auto!important;min-height:0!important;max-height:none!important}\nz-live-widget{display:block;width:280px;margin:0 auto;padding:0}\n</style>\n<script>\nif(!window.ZLiveWidgetDefined){\nwindow.ZLiveWidgetDefined=true;\nclass ZLiveWidget extends HTMLElement{\nconstructor(){super();this.attachShadow({mode:'open'});this.timers=[]}\nconnectedCallback(){if(this.rendered)return;this.rendered=true;const kv=this.extractData();this.renderUI(kv)}\ndisconnectedCallback(){this.timers.forEach(t=>clearInterval(t))}\nextractData(){const kv={},mR=/\\[([^=\\[\\]]+)=([^\\[\\]]+)\\]/g;const container=this.closest('.item,.content,uni-view.content')||this.parentElement;if(container){container.querySelectorAll('.z-live-data').forEach(n=>{mR.lastIndex=0;const m=mR.exec(n.textContent);if(m)kv[m[1].trim()]=m[2].trim()})}return kv}\nrenderUI(kv){\nconst style=document.createElement('style');\nstyle.textContent=`\n.root{color:#c9a84c;font-family:'STKaiti','KaiTi','华文楷体','Noto Serif SC',serif;box-sizing:border-box;width:280px;min-width:280px;max-width:280px;height:500px;min-height:500px;max-height:500px;margin:10px auto;background:radial-gradient(ellipse at 20% 10%,rgba(255,215,180,.12),transparent 40%),radial-gradient(ellipse at 80% 90%,rgba(200,180,255,.08),transparent 40%),linear-gradient(160deg,#f7f0e8 0%,#f0e8dd 40%,#e8dfd0 100%);background-image:repeating-linear-gradient(45deg,rgba(200,185,165,.02)0 2px,transparent 2px 4px),repeating-linear-gradient(-45deg,rgba(200,185,165,.02)0 2px,transparent 2px 4px),radial-gradient(ellipse at 50% 0,rgba(255,215,150,.06),transparent 40%),radial-gradient(ellipse at 50% 100%,rgba(180,150,255,.04),transparent 30%);border:1.5px solid rgba(201,168,76,.35);border-radius:3px;padding:14px;box-shadow:0 4px 30px rgba(100,80,60,.12),inset 0 0 0 1px rgba(255,248,240,.3),inset 0 0 40px rgba(200,180,160,.04);overflow:hidden;display:flex;flex-direction:column;flex-shrink:0;position:relative}\n/* 四角·极淡墨痕 代替硬角花 */\n.root::before{content:'';position:absolute;top:0;left:0;width:40px;height:40px;border-top:2px solid rgba(201,168,76,.15);border-left:2px solid rgba(201,168,76,.15);border-radius:0 0 12px 0;pointer-events:none}\n.root::after{content:'';position:absolute;bottom:0;right:0;width:40px;height:40px;border-bottom:2px solid rgba(201,168,76,.15);border-right:2px solid rgba(201,168,76,.15);border-radius:12px 0 0 0;pointer-events:none}\n/* 上下·旧纸浸染线 */\n.root .g{position:absolute;left:10%;right:10%;height:1.5px;background:linear-gradient(90deg,transparent,rgba(201,168,76,.2),rgba(201,168,76,.3),rgba(201,168,76,.2),transparent);box-shadow:0 0 8px rgba(201,168,76,.05)}\n.root .gt{top:4px}.root .gb{bottom:4px}\n/* 浮动灵气粒子——比之前更淡更散 */\n@keyframes f{0%{transform:translate(0,0) scale(1);opacity:.2}50%{transform:translate(8px,-12px) scale(1.1);opacity:.4}100%{transform:translate(-4px,4px) scale(.8);opacity:.2}}\n.root .p{position:absolute;width:6px;height:6px;border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,.2),transparent);pointer-events:none;animation:f 5s ease-in-out infinite}\n.root .p:nth-child(1){top:12%;left:6%;animation-delay:0s}\n.root .p:nth-child(2){top:55%;right:4%;animation-delay:1.4s;width:4px;height:4px}\n.root .p:nth-child(3){bottom:25%;left:10%;animation-delay:2.8s;width:8px;height:8px}\n.root .p:nth-child(4){top:35%;left:3%;animation-delay:.6s;width:3px;height:3px}\n.root .p:nth-child(5){bottom:8%;right:12%;animation-delay:3.6s;width:5px;height:5px}\n.ov{flex-shrink:0;border-bottom:1px solid rgba(201,168,76,.1);padding-bottom:6px;margin-bottom:10px;display:flex;flex-direction:column;gap:2px;z-index:2;position:relative}\n.ov .r{display:flex;align-items:center;font-size:11px;color:#c9a84c;letter-spacing:.5px}\n.ov .i{width:16px;text-align:center;margin-right:6px;font-size:12px;opacity:.6}\n.ov .l{color:#b8942e;font-weight:600;margin-right:4px}\n.ov .v{color:#e8d48c;font-weight:400;text-shadow:0 0 8px rgba(201,168,76,.05)}\n.vp{flex:1;overflow:hidden;position:relative;z-index:2;min-height:0}\n.sl{position:absolute;top:0;left:0;right:0;bottom:0;display:none;overflow-y:auto;padding-right:4px}\n.sl.active{display:block}\n.sl::-webkit-scrollbar{width:3px}\n.sl::-webkit-scrollbar-track{background:rgba(200,185,165,.08)}\n.sl::-webkit-scrollbar-thumb{background:rgba(201,168,76,.25);border-radius:0}\n.hd{display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(201,168,76,.08);padding-bottom:10px;margin-bottom:10px;position:relative}\n.hd::after{content:'✦';position:absolute;bottom:-6px;right:0;font-size:10px;color:#c9a84c;opacity:.2}\n.av{width:72px;height:96px;border-radius:2px;border:1.5px solid rgba(201,168,76,.2);background:#e8ddd0;background-size:cover;background-position:center;flex-shrink:0;box-shadow:0 0 16px rgba(201,168,76,.04)}\n.nm{font-size:18px;font-weight:700;color:#b8942e;letter-spacing:2px;word-break:break-word;text-shadow:0 0 20px rgba(201,168,76,.04)}\n.nm::after{content:'·灵';font-size:10px;font-weight:300;color:#c9a84c;letter-spacing:1px;margin-left:4px;opacity:.6}\n.lr{display:flex;align-items:center;gap:6px;margin-top:4px;font-size:12px;flex-wrap:wrap}\n.ll{color:#c9a84c;flex-shrink:0;font-style:italic;letter-spacing:1px;opacity:.7}\n.lb{flex:1;height:6px;background:rgba(200,185,165,.15);border-radius:0;overflow:hidden;min-width:40px;border:1px solid rgba(201,168,76,.08);position:relative}\n.lb::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(90deg,transparent,rgba(255,248,240,.1),transparent);animation:s 2.5s infinite}\n@keyframes s{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}\n.lf{height:100%;border-radius:0;background:linear-gradient(90deg,#c9a84c,#e8c84c,#c9a84c);transition:width .4s;box-shadow:0 0 12px rgba(201,168,76,.08)}\n.ln{color:#c9a84c;font-weight:600;font-size:12px;min-width:28px;text-align:right;flex-shrink:0}\n.ds{margin-top:8px;padding:8px 10px;background:rgba(232,221,208,.08);border-left:2px solid rgba(201,168,76,.15);border-radius:0 2px 2px 0;font-size:12px;line-height:1.6;color:#b8942e;word-break:break-word}\n.ds .dl{color:#c9a84c;font-size:9px;letter-spacing:2px;display:block;margin-bottom:2px;opacity:.6}\n.st{margin-top:6px;padding:8px 10px;background:rgba(232,221,208,.04);border-left:2px solid rgba(201,168,76,.1);border-radius:0 2px 2px 0;font-size:12px;line-height:1.6;color:#b8942e;word-break:break-word}\n.st .slb{color:#c9a84c;font-size:9px;letter-spacing:2px;display:block;margin-bottom:2px;opacity:.6}\n.nv{display:flex;justify-content:center;align-items:center;gap:16px;padding:8px 0 4px;border-top:1px solid rgba(201,168,76,.08);flex-shrink:0;z-index:2;position:relative}\n.ar{color:#c9a84c;font-size:18px;cursor:pointer;padding:0 10px;user-select:none;font-weight:300;transition:.2s;opacity:.6}\n.ar:hover{color:#e8c84c;text-shadow:0 0 20px rgba(201,168,76,.1);opacity:1}\n.dt{color:#c9a84c;font-size:12px;font-weight:500;letter-spacing:1px;opacity:.5}\n.dt::before{content:'❀';margin-right:4px;opacity:.2}\n.dt::after{content:'❀';margin-left:4px;opacity:.2}\n.opts{flex-shrink:0;display:flex;flex-direction:column;gap:4px;padding-top:8px;border-top:1px solid rgba(201,168,76,.08);z-index:2;position:relative}\n.opt{background:rgba(201,168,76,.02);border:1px solid rgba(201,168,76,.08);border-radius:2px;padding:6px 10px;font-size:12px;font-family:inherit;color:#c9a84c;text-align:left;cursor:pointer;transition:all .15s;letter-spacing:.5px;line-height:1.4;opacity:.8}\n.opt:hover{background:rgba(201,168,76,.06);border-color:rgba(201,168,76,.2);transform:translateX(2px);box-shadow:0 0 16px rgba(201,168,76,.04);opacity:1}\n.opt:active{transform:scale(.98);background:rgba(201,168,76,.1)}\n.opt .op{color:#c9a84c;opacity:.3;margin-right:6px;font-size:10px}\n`;\nthis.shadowRoot.appendChild(style);\n\nconst t=kv['时间']||'',pl=kv['地点']||'',ss=kv['状态']||'';\nconst opts=[];for(let i=1;i<=4;i++){const o=kv['选项'+i]||'';if(o.trim())opts.push(o.trim())}\nconst roles=[];let idx=1;while(kv['角色'+idx+'_姓名']){roles.push({name:kv['角色'+idx+'_姓名']||'未知',like:parseInt(kv['角色'+idx+'_好感'])||50,avatar:kv['角色'+idx+'_头像']||'',look:kv['角色'+idx+'_外貌']||'未填写',status:kv['角色'+idx+'_状态']||'未填写'});idx++}\nif(roles.length===0){const e=document.createElement('div');e.className='root';e.textContent='没有角色数据';this.shadowRoot.appendChild(e);return}\nconst root=document.createElement('div');root.className='root';\n['gt','gb'].forEach(c=>{const d=document.createElement('div');d.className='g '+c;root.appendChild(d)});\nfor(let i=0;i<5;i++){const d=document.createElement('div');d.className='p';root.appendChild(d)}\nif(t||pl||ss){const ov=document.createElement('div');ov.className='ov';\nif(t){const r=document.createElement('div');r.className='r';r.innerHTML='<span class=\"i\">⏳</span><span class=\"l\">时辰</span><span class=\"v\">'+t+'</span>';ov.appendChild(r)}\nif(pl){const r=document.createElement('div');r.className='r';r.innerHTML='<span class=\"i\">📍</span><span class=\"l\">地点</span><span class=\"v\">'+pl+'</span>';ov.appendChild(r)}\nif(ss){const r=document.createElement('div');r.className='r';r.innerHTML='<span class=\"i\">🌿</span><span class=\"l\">状态</span><span class=\"v\">'+ss+'</span>';ov.appendChild(r)}\nroot.appendChild(ov)}\nconst vp=document.createElement('div');vp.className='vp';\nroles.forEach((role,index)=>{const sl=document.createElement('div');sl.className='sl'+(index===0?' active':'');sl.dataset.index=index;const avStyle=role.avatar?'background-image:url('+role.avatar+')':'';const likePct=Math.min(100,Math.max(0,role.like));sl.innerHTML='<div class=\"hd\"><div class=\"av\" style=\"'+avStyle+'\"></div><div class=\"inf\"><div class=\"nm\">'+role.name+'</div><div class=\"lr\"><span class=\"ll\">☯ 道缘</span><div class=\"lb\"><div class=\"lf\" style=\"width:'+likePct+'%\"></div></div><span class=\"ln\">'+likePct+'%</span></div></div></div><div class=\"ds\"><span class=\"dl\">📜 灵台</span>'+role.look+'</div><div class=\"st\"><span class=\"slb\">⚡ 气机</span>'+role.status+'</div>';vp.appendChild(sl)});\nroot.appendChild(vp);\nconst nav=document.createElement('div');nav.className='nv';\nconst prev=document.createElement('span');prev.className='ar';prev.textContent='◀';\nconst dot=document.createElement('span');dot.className='dt';dot.textContent='1/'+roles.length;\nconst next=document.createElement('span');next.className='ar';next.textContent='▶';\nnav.appendChild(prev);nav.appendChild(dot);nav.appendChild(next);root.appendChild(nav);\nif(opts.length>0){const oc=document.createElement('div');oc.className='opts';const pre=['┃','┃','┃','┃'];opts.forEach((ot,i)=>{const btn=document.createElement('div');btn.className='opt';btn.innerHTML='<span class=\"op\">'+pre[i]+'</span>'+ot;btn.addEventListener('click',(e)=>{e.stopPropagation();const ta=document.querySelector('.chat-input-scope textarea')||document.querySelector('.chatMsgTextarea textarea')||document.querySelector('.uni-textarea textarea')||document.querySelector('textarea');if(ta){const cv=ta.value;ta.value=cv+(cv&&!cv.endsWith('\\n')?'\\n':'')+ot;ta.dispatchEvent(new Event('input',{bubbles:true}));ta.focus()}});oc.appendChild(btn)});root.appendChild(oc)}\nthis.shadowRoot.appendChild(root);\nlet cur=0;const slides=vp.querySelectorAll('.sl');const update=(ni)=>{slides.forEach((el,i)=>{el.classList.toggle('active',i===ni)});dot.textContent=(ni+1)+'/'+roles.length;cur=ni};\nprev.addEventListener('click',(e)=>{e.stopPropagation();update((cur-1+roles.length)%roles.length)});\nnext.addEventListener('click',(e)=>{e.stopPropagation();update((cur+1)%roles.length)});\n}}\ncustomElements.define('z-live-widget',ZLiveWidget);}\n</script>","scriptName":"状态栏3","findRegex":"<GC_SCRIPT>"}]}